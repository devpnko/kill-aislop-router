{
  "profile_version": 1,
  "project_id": "example-product",
  "default_locale": "en-US",
  "approved_design_system": true,
  "design_system": {
    "id": "example-product-ui",
    "version": "1.0.0",
    "status": "approved",
    "authority_receipt": "planning-evidence/owner-approval.json",
    "authority_digest": "sha256:d19bdc7bfbb1b6abdd11f0a3df4e759c6c7537eeaec358a5133ac6a2671c00df",
    "source_scope_id": "example-operator-ui-v1"
  },
  "planning": {
    "required": false,
    "surface_receipts": {
      "operator-product-ui": "service-planning-gate.example.json"
    }
  },
  "tool_lock": "registry/tool-lock.json",
  "local_adapters": {
    "project-contract": "docs/product-contract.md",
    "project-design-system": "docs/design-system.md",
    "project-systemizer": "docs/systemization-protocol.md",
    "design-system-contract-review": "reviewers/design-system-contract",
    "locale-copy-review": "reviewers/en-US-copy",
    "domain-authority-review": "reviewers/product-owner",
    "privacy-authority-review": "reviewers/privacy-owner",
    "browser-evidence": "tests/playwright",
    "owner-approval": "reviewers/release-owner"
  },
  "external_adapters": {
    "kill-ai-slop": {"status": "available", "version": "git:96d1ca5"},
    "anti-slop": {"status": "available", "version": "git:c22857f"},
    "hallmark": {"status": "unavailable", "version": "git:13ac0ec"},
    "no-ai-slop": {"status": "unavailable", "version": "git:d30eddb"}
  },
  "fallback_adapters": {
    "hallmark": [
      {
        "id": "independent-rendered-craft-agent",
        "kind": "agent",
        "status": "routable",
        "version": "review-contract:rendered-craft-v1",
        "target": "reviewers/rendered-craft",
        "executor": "fresh-agent-review",
        "strength": 3,
        "capabilities": ["rendered-hierarchy", "visual-specificity", "visual-restraint", "component-coherence"],
        "independent_from_creator": true
      }
    ],
    "no-ai-slop": [
      {
        "id": "independent-copy-agent",
        "kind": "agent",
        "status": "routable",
        "version": "review-contract:copy-v1",
        "target": "reviewers/copy",
        "executor": "fresh-agent-review",
        "strength": 3,
        "capabilities": ["copy-specificity", "copy-honesty", "copy-concision"],
        "independent_from_creator": true
      }
    ]
  },
  "surface_overrides": {
    "operator-product-ui": {
      "creator": "project-design-system",
      "exclude_tools": ["taste-skill"]
    },
    "consumer-product-ui": {
      "creator_by_direction": {"approved": "project-design-system"},
      "exclude_tools": []
    }
  },
  "high_risk_gates": [
    "domain-authority-review",
    "privacy-authority-review",
    "owner-approval"
  ],
  "evidence": {
    "browser": "playwright",
    "required_viewports": ["mobile", "desktop"],
    "required_checks": ["keyboard", "state", "overflow", "contrast", "zoom-200", "visual-regression", "screen-reader"]
  }
}
