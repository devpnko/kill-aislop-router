{
  "name": "killsloprouter",
  "version": "1.0.0",
  "description": "Fail-closed routing and resumable evidence automation for anti-AI-slop review",
  "type": "module",
  "license": "MIT",
  "bin": {
    "killsloprouter": "./bin/killsloprouter.mjs",
    "killslop": "./bin/killsloprouter.mjs"
  },
  "exports": {
    ".": "./src/router.mjs",
    "./audit": "./src/audit.mjs",
    "./automation": "./src/automation.mjs",
    "./execution": "./src/execution.mjs",
    "./integrity": "./src/integrity.mjs",
    "./planning": "./src/planning.mjs"
  },
  "files": [
    "bin",
    "src",
    "router",
    "schemas",
    "registry",
    "docs",
    "examples",
    "skills",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "check": "npm test && node scripts/static-check.mjs && node bin/killsloprouter.mjs doctor --profile examples/project-profile.example.json",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-slop",
    "agent-skill",
    "design-review",
    "frontend",
    "ui-audit",
    "orchestrator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devpnko/kill-aislop-router.git"
  },
  "homepage": "https://github.com/devpnko/kill-aislop-router#readme",
  "bugs": {
    "url": "https://github.com/devpnko/kill-aislop-router/issues"
  }
}
