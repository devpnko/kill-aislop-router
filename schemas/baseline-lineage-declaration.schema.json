{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/baseline-lineage-declaration.schema.json",
  "title": "KillSlopRouter Parent Baseline And Slice Lineage Declaration",
  "type": "object",
  "required": [
    "baseline_lineage_version",
    "lineage_id",
    "relationship",
    "parent_baseline",
    "candidate",
    "inheritance",
    "promotion"
  ],
  "properties": {
    "baseline_lineage_version": {"const": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "relationship": {"const": "slice-of"},
    "parent_baseline": {
      "allOf": [
        {"$ref": "#/$defs/artifact-set"},
        {"not": {"required": ["slice_id"]}}
      ]
    },
    "candidate": {
      "allOf": [
        {"$ref": "#/$defs/artifact-set"},
        {
          "type": "object",
          "required": ["slice_id"],
          "properties": {
            "slice_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "inheritance": {
      "type": "object",
      "required": ["inherits", "slice_owned", "forbidden_parent_changes"],
      "properties": {
        "inherits": {"$ref": "#/$defs/non-empty-strings"},
        "slice_owned": {"$ref": "#/$defs/non-empty-strings"},
        "forbidden_parent_changes": {"$ref": "#/$defs/non-empty-strings"}
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": ["authority", "supersedes_parent"],
      "properties": {
        "authority": {"const": "explicit-owner-only"},
        "supersedes_parent": {"const": false}
      },
      "additionalProperties": false
    },
    "lineage_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "non-empty-strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "artifact-set": {
      "type": "object",
      "required": ["id", "version", "artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "slice_id": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
