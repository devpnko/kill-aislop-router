{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/codex-review-output.schema.json",
  "title": "KillSlopRouter Codex Review Output",
  "type": "object",
  "required": ["verdict", "capabilities_checked", "findings", "resolutions"],
  "properties": {
    "verdict": {"enum": ["pass", "pass_with_findings", "block"]},
    "capabilities_checked": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "resolutions": {
      "type": "array",
      "items": {"$ref": "#/$defs/resolution"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "rule_id",
        "severity",
        "category",
        "location",
        "claim",
        "evidence",
        "suggested_fix",
        "disposition",
        "rationale",
        "conflicts_with"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_id": {"type": ["string", "null"]},
        "severity": {"enum": ["blocker", "major", "minor", "note"]},
        "category": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "suggested_fix": {"type": ["string", "null"]},
        "disposition": {
          "enum": ["open", "fixed", "false-positive", "accepted-risk", "informational", "deferred"]
        },
        "rationale": {"type": ["string", "null"]},
        "conflicts_with": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["finding_refs", "decision", "basis", "rationale"],
      "properties": {
        "finding_refs": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
