{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/reference-packet.schema.json",
  "title": "KillSlopRouter reference intelligence packet",
  "type": "object",
  "required": [
    "reference_packet_version", "packet_id", "run_id", "journey_identity", "participant",
    "stage_id", "provider", "assigned_capabilities", "minimum_strength",
    "required_permissions", "forbidden_permissions", "evidence_contract", "reference_task", "packet_digest"
  ],
  "properties": {
    "reference_packet_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "participant": {"$ref": "participant.schema.json"},
    "stage_id": {"enum": ["reference-discovery", "reference-grammar", "reference-review"]},
    "provider": {
      "type": "object",
      "required": ["id", "kind", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "external"},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "assigned_capabilities": {"$ref": "#/$defs/strings"},
    "minimum_strength": {"type": "integer", "minimum": 1, "maximum": 4},
    "required_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "network:external"]}
    },
    "forbidden_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "network:external"]}
    },
    "evidence_contract": {"type": "object"},
    "reference_task": {
      "type": "object",
      "required": [
        "kind", "project_id", "surface", "locales", "brief_digest",
        "authority_graph_digest", "human_design_reasoning"
      ],
      "properties": {
        "kind": {"enum": ["reference-discovery", "reference-grammar", "reference-review"]},
        "project_id": {"type": "string", "minLength": 1},
        "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
        "locales": {"$ref": "#/$defs/strings"},
        "brief_digest": {"$ref": "#/$defs/digest"},
        "authority_graph_digest": {"$ref": "#/$defs/digest"},
        "human_design_reasoning": {
          "type": "object",
          "required": ["registry_digest", "authority_scope", "source_pixels_included", "design_checks", "lenses"],
          "properties": {
            "registry_digest": {"$ref": "#/$defs/digest"},
            "authority_scope": {"const": "non-authoritative-research-aid"},
            "source_pixels_included": {"const": false},
            "design_checks": {
              "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true,
              "items": {"$ref": "human-design-reasoning-registry.schema.json#/$defs/design_check"}
            },
            "lenses": {"type": "array", "minItems": 8, "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "packet_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage_id": {"enum": ["reference-grammar", "reference-review"]}
        },
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "required_permissions": {
            "not": {"contains": {"const": "network:external"}}
          },
          "forbidden_permissions": {
            "contains": {"const": "network:external"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "reference-discovery"}},
        "required": ["stage_id"]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "required_permissions": {
                "contains": {"const": "network:external"}
              },
              "forbidden_permissions": {
                "not": {"contains": {"const": "network:external"}}
              }
            }
          },
          {
            "properties": {
              "required_permissions": {
                "not": {"contains": {"const": "network:external"}}
              },
              "forbidden_permissions": {
                "contains": {"const": "network:external"}
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
