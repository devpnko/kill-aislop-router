{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-font-report.schema.json",
  "title": "KillSlopRouter design font evidence",
  "type": "object",
  "required": ["font_report_version", "required_locales", "all_required_locales_covered", "families"],
  "properties": {
    "font_report_version": {"const": 1},
    "required_locales": {"$ref": "#/$defs/strings"},
    "all_required_locales_covered": {"const": true},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "role", "source", "availability", "locales", "fallback", "license"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "availability": {"enum": ["embedded", "bundled", "installed", "licensed"]},
          "locales": {"$ref": "#/$defs/strings"},
          "fallback": {"type": "string", "minLength": 1},
          "license": {
            "type": "object",
            "required": ["status", "identifier", "basis"],
            "properties": {
              "status": {"const": "cleared"},
              "identifier": {"type": "string", "minLength": 1},
              "basis": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
