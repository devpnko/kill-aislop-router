{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/human-design-reasoning-registry.schema.json",
  "title": "KillSlopRouter non-authoritative human-design reasoning registry",
  "type": "object",
  "required": [
    "human_design_reasoning_registry_version", "authority_scope",
    "source_pixels_included", "research_basis", "design_checks", "lenses"
  ],
  "properties": {
    "human_design_reasoning_registry_version": {"const": 1},
    "authority_scope": {"const": "non-authoritative-research-aid"},
    "source_pixels_included": {"const": false},
    "research_basis": {
      "type": "object",
      "required": [
        "source_provider", "source_url", "sampled_at", "sample_size",
        "selection_method", "caveats"
      ],
      "properties": {
        "source_provider": {"const": "uibowl"},
        "source_url": {"type": "string", "format": "uri"},
        "sampled_at": {"type": "string", "format": "date-time"},
        "sample_size": {
          "type": "object",
          "required": ["products", "screens", "mobile_products", "desktop_products"],
          "properties": {
            "products": {"type": "integer", "minimum": 1},
            "screens": {"type": "integer", "minimum": 1},
            "mobile_products": {"type": "integer", "minimum": 0},
            "desktop_products": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "selection_method": {"type": "string", "minLength": 1},
        "caveats": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "design_checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/design_check"}
    },
    "lenses": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "lens_id", "question", "decision_test", "failure_if_ignored",
          "applies_to", "tradeoff", "anti_copy_boundary"
        ],
        "properties": {
          "lens_id": {"$ref": "#/$defs/id"},
          "question": {"type": "string", "minLength": 1},
          "decision_test": {"type": "string", "minLength": 1},
          "failure_if_ignored": {"type": "string", "minLength": 1},
          "applies_to": {"$ref": "#/$defs/strings"},
          "tradeoff": {"type": "string", "minLength": 1},
          "anti_copy_boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "design_check": {
      "type": "object",
      "required": [
        "check_id", "lens_ids", "pass_condition", "required_evidence", "stages", "failure_code"
      ],
      "properties": {
        "check_id": {"enum": [
          "decision-inventory", "state-cardinality", "accent-role-budget",
          "comparison-slot-alignment", "risk-near-action", "density-by-cadence",
          "live-data-scaffolding", "state-completeness", "responsive-reprioritization",
          "promotional-citation-firewall", "source-composition-independence"
        ]},
        "lens_ids": {"$ref": "#/$defs/strings"},
        "pass_condition": {"type": "string", "minLength": 1},
        "required_evidence": {"$ref": "#/$defs/strings"},
        "stages": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["direction-review", "color-review"]}
        },
        "failure_code": {
          "type": "string",
          "pattern": "^reference-check-failed:[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      },
      "additionalProperties": false
    },
    "strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
