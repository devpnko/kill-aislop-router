{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/reference-candidate-catalog.schema.json",
  "title": "Non-authoritative, source-linked research candidate catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_candidate_catalog_version",
    "catalog_id",
    "prepared_on",
    "status",
    "authority_scope",
    "audience",
    "source_provider",
    "source_pixels_included",
    "source_assets_included",
    "creator_input_approved",
    "visual_authority_granted",
    "design_ready",
    "rights",
    "limits",
    "studies",
    "families",
    "discovery_routes",
    "collection_backlog",
    "entries"
  ],
  "properties": {
    "reference_candidate_catalog_version": {
      "const": 1
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "prepared_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "discovery-only"
    },
    "authority_scope": {
      "const": "non-authoritative-discovery-index"
    },
    "audience": {
      "const": [
        "internal-researcher",
        "independent-critic",
        "owner"
      ]
    },
    "source_provider": {
      "const": "uibowl"
    },
    "source_pixels_included": {
      "const": false
    },
    "source_assets_included": {
      "const": false
    },
    "creator_input_approved": {
      "const": false
    },
    "visual_authority_granted": {
      "const": false
    },
    "design_ready": {
      "const": false
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source_notice_url",
        "redistribution",
        "creator_pixel_access",
        "cross_project_approval_reuse"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "source_notice_url": {
          "type": "string",
          "pattern": "^https://uibowl\\.io/"
        },
        "redistribution": {
          "const": false
        },
        "creator_pixel_access": {
          "const": false
        },
        "cross_project_approval_reuse": {
          "const": false
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observed_on",
          "path",
          "digest",
          "frame_index_path",
          "frame_index_digest",
          "source_captures_included"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "observed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^docs/research/[a-z0-9._-]+\\.(md|json)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "frame_index_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^docs/research/[a-z0-9._-]+\\.(md|json)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "frame_index_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_captures_included": {
            "const": false
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "job",
          "component_families",
          "research_states",
          "catalog_coverage",
          "discovery_queries",
          "discovery_route_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "job": {
            "type": "string",
            "minLength": 1
          },
          "component_families": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "research_states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "catalog_coverage": {
            "enum": [
              "gap",
              "weak",
              "historical-only"
            ]
          },
          "discovery_queries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "discovery_route_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "discovery_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url",
          "checked_on",
          "evidence",
          "source_frames_inspected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://uibowl\\.io/"
          },
          "checked_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "const": "public-page-text-only"
          },
          "source_frames_inspected": {
            "const": false
          }
        }
      }
    },
    "collection_backlog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "family_ids",
          "reason",
          "done_when"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "family_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "done_when": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "ecosystem",
          "platform",
          "family_ids",
          "component_families",
          "indexing_basis",
          "evidence_level",
          "study_id",
          "study_locator",
          "observed_on",
          "last_revalidated_on",
          "source_product_id",
          "source_entry_url",
          "source_locator_kind",
          "frames",
          "observation",
          "transfer_hypothesis",
          "harmful_when",
          "component_craft_status",
          "responsive_evidence",
          "interaction_evidence",
          "popularity_status",
          "capture_readiness",
          "design_ready",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "platform": {
            "enum": [
              "mobile",
              "desktop"
            ]
          },
          "family_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "component_families": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "indexing_basis": {
            "const": "researcher-proposed-facets-not-verified-source-classification"
          },
          "evidence_level": {
            "enum": [
              "study-listed",
              "historical-summary",
              "historical-frame-notes"
            ]
          },
          "study_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "study_locator": {
            "type": "string",
            "minLength": 1
          },
          "observed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_revalidated_on": {
            "const": null
          },
          "source_product_id": {
            "const": null
          },
          "source_entry_url": {
            "type": "string",
            "pattern": "^https://uibowl\\.io/"
          },
          "source_locator_kind": {
            "enum": [
              "study-index-only",
              "historically-recorded-frame-links"
            ]
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "url",
                "role",
                "recorded_state"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://uibowl\\.io/"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "recorded_state": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "observation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "transfer_hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "harmful_when": {
            "type": "string",
            "minLength": 1
          },
          "component_craft_status": {
            "const": "capture-extraction-required"
          },
          "responsive_evidence": {
            "const": "not-verified"
          },
          "interaction_evidence": {
            "const": "not-verified"
          },
          "popularity_status": {
            "const": "not-revalidated"
          },
          "capture_readiness": {
            "const": "not-bound"
          },
          "design_ready": {
            "const": false
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_level": {
                  "const": "study-listed"
                }
              }
            },
            "then": {
              "properties": {
                "observation": {
                  "type": "null"
                },
                "frames": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_level": {
                  "const": "historical-summary"
                }
              }
            },
            "then": {
              "properties": {
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "frames": {
                  "maxItems": 0
                },
                "source_locator_kind": {
                  "const": "study-index-only"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_level": {
                  "const": "historical-frame-notes"
                }
              }
            },
            "then": {
              "properties": {
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "frames": {
                  "minItems": 1
                },
                "source_locator_kind": {
                  "const": "historically-recorded-frame-links"
                }
              }
            }
          }
        ]
      }
    }
  }
}
