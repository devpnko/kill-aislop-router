{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/automation-run.schema.json",
  "title": "KillSlopRouter Resumable Automation Run",
  "type": "object",
  "required": [
    "automation_run_version",
    "run_id",
    "journey_identity",
    "status",
    "state_path",
    "state_directory",
    "request",
    "paths",
    "steps",
    "attempts",
    "blockers",
    "pending",
    "state_digest"
  ],
  "properties": {
    "automation_run_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "status": {"enum": ["running", "manual_pending", "blocked", "complete"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "state_path": {"type": "string", "minLength": 1},
    "state_directory": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "paths": {"type": "object"},
    "steps": {"type": "object"},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "in_flight": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/in_flight"}
      ]
    },
    "lease_recoveries": {
      "type": "array",
      "items": {"$ref": "#/$defs/receipt_snapshot"}
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "pending": {"type": "array", "items": {"type": "string"}},
    "identity_migration": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "digest", "receipt_digest"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "digest": {"$ref": "#/$defs/digest"},
            "receipt_digest": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        }
      ]
    },
    "baseline_observation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/baseline_observation"}
      ]
    },
    "final_audit_status": {"type": ["string", "null"]},
    "final_receipt_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "receipt_snapshot": {
      "type": "object",
      "required": ["path", "digest", "receipt_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "in_flight": {
      "type": "object",
      "required": [
        "automation_in_flight_version", "packet_id", "packet_digest", "provider_id",
        "participant", "adapter", "host_manifest_digest", "permission_scopes",
        "strength", "capabilities", "attempt", "output_directory", "started_at"
      ],
      "properties": {
        "automation_in_flight_version": {"const": 1},
        "packet_id": {"type": "string", "minLength": 1},
        "packet_digest": {"$ref": "#/$defs/digest"},
        "provider_id": {"type": "string", "minLength": 1},
        "participant": {"$ref": "participant.schema.json"},
        "adapter": {"type": "string", "minLength": 1},
        "host_manifest_digest": {"$ref": "#/$defs/digest"},
        "permission_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "strength": {"type": "integer", "minimum": 1, "maximum": 4},
        "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "attempt": {"type": "integer", "minimum": 1},
        "output_directory": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "baseline_observation": {
      "type": "object",
      "required": [
        "ui_observation_version",
        "state_path",
        "state_file_digest",
        "state_digest",
        "run_id",
        "journey_identity",
        "audit_digest",
        "final_file_digest",
        "final_receipt_digest",
        "browser_packet_id",
        "browser_result_digest",
        "project_id",
        "profile_digest",
        "surface",
        "artifact_digests",
        "required_scenarios",
        "observed_at",
        "observation_digest"
      ],
      "properties": {
        "ui_observation_version": {"const": 1},
        "state_path": {"type": "string", "minLength": 1},
        "state_file_digest": {"$ref": "#/$defs/digest"},
        "state_digest": {"$ref": "#/$defs/digest"},
        "run_id": {"type": "string", "minLength": 1},
        "journey_identity": {"$ref": "journey-identity.schema.json"},
        "audit_digest": {"$ref": "#/$defs/digest"},
        "final_file_digest": {"$ref": "#/$defs/digest"},
        "final_receipt_digest": {"$ref": "#/$defs/digest"},
        "browser_packet_id": {"type": "string", "minLength": 1},
        "browser_result_digest": {"$ref": "#/$defs/digest"},
        "project_id": {"type": "string", "minLength": 1},
        "profile_digest": {"$ref": "#/$defs/digest"},
        "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
        "artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/digest"}
        },
        "required_scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "observation_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
