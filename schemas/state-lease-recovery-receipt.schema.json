{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/state-lease-recovery-receipt.schema.json",
  "title": "KillSlopRouter State Lease Recovery Receipt",
  "type": "object",
  "required": [
    "state_lease_recovery_receipt_version", "status", "run_id", "journey_identity",
    "resume_authority_digest",
    "state_path", "recovered_at", "recovered_lease", "abandoned_attempt",
    "initialization_reconciliation", "receipt_digest"
  ],
  "properties": {
    "state_lease_recovery_receipt_version": {"const": 3},
    "status": {"const": "recovered"},
    "run_id": {"type": ["string", "null"]},
    "journey_identity": {
      "oneOf": [{"type": "null"}, {"$ref": "journey-identity.schema.json"}]
    },
    "resume_authority_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "state_path": {"type": "string", "minLength": 1},
    "recovered_at": {"type": "string", "format": "date-time"},
    "recovered_lease": {
      "type": "object",
      "required": [
        "lease_digest", "owner_token_digest", "owner_pid", "owner_process_identity",
        "acquired_at", "operation",
        "phase", "state_digest", "recover_after", "active_packet"
      ],
      "properties": {
        "lease_digest": {"$ref": "#/$defs/digest"},
        "owner_token_digest": {"$ref": "#/$defs/digest"},
        "owner_pid": {"type": "integer", "minimum": 1},
        "owner_process_identity": {"$ref": "#/$defs/process_identity"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "operation": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "state_digest": {"$ref": "#/$defs/state_digest"},
        "recover_after": {"type": "string", "format": "date-time"},
        "active_packet": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "abandoned_attempt": {"type": ["object", "null"]},
    "initialization_reconciliation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "initialization_reconciliation_version", "previous_state_digest",
            "reconciled_anchor_ids", "reconciled_steps", "initialization_authority",
            "reconciled_initialization_graph_digest"
          ],
          "properties": {
            "initialization_reconciliation_version": {"const": 3},
            "previous_state_digest": {"$ref": "#/$defs/digest"},
            "reconciled_anchor_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "plan-sidecar", "plan-receipt",
                  "planning-verification-receipt", "audit-sidecar",
                  "audit-init-receipt", "packets-sidecar", "dispatch-receipt"
                ]
              }
            },
            "reconciled_steps": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["plan", "planning-verification", "audit-init", "dispatch"]
              }
            },
            "initialization_authority": {
              "type": "object",
              "required": ["status", "snapshot"],
              "properties": {
                "status": {"const": "bound"},
                "snapshot": {
                  "type": "object",
                  "required": [
                    "path", "digest", "receipt_digest", "initialization_graph_digest"
                  ],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "digest": {"$ref": "#/$defs/digest"},
                    "receipt_digest": {"$ref": "#/$defs/digest"},
                    "initialization_graph_digest": {"$ref": "#/$defs/digest"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "reconciled_initialization_graph_digest": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        }
      ]
    },
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "process_identity": {
      "type": "object",
      "required": ["process_identity_version", "method", "marker"],
      "properties": {
        "process_identity_version": {"const": 1},
        "method": {"type": "string", "minLength": 1},
        "marker": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "state_digest": {
      "oneOf": [
        {"const": "absent"},
        {"$ref": "#/$defs/digest"}
      ]
    }
  },
  "additionalProperties": false
}
