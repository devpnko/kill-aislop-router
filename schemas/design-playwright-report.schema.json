{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-playwright-report.schema.json",
  "title": "KillSlopRouter executed design-state browser proof",
  "description": "Version 2 records actual native scenarios. Runtime validation also recomputes exact coverage and file digests against immutable host authority. A failed report is diagnostic evidence, not approval.",
  "type": "object",
  "required": ["design_playwright_report_version", "run_id", "packet_id", "packet_digest", "scenario_digest", "subject_id", "subject_result_digest", "prototype", "browser", "checks", "coverage_semantics", "executions"],
  "properties": {
    "design_playwright_report_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_digest": {"$ref": "#/$defs/digest"},
    "scenario_digest": {"$ref": "#/$defs/digest"},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_result_digest": {"$ref": "#/$defs/digest"},
    "prototype": {
      "type": "object", "required": ["path", "digest"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "browser": {
      "type": "object", "required": ["engine", "implementation", "version"],
      "properties": {"engine": {"const": "playwright"}, "implementation": {"const": "chromium"}, "version": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "checks": {"$ref": "#/$defs/checks"},
    "coverage_semantics": {"const": "native-scenario-visible-state-locale-matrix"},
    "executions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/execution"}}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "steps": {
      "type": "array", "items": {
        "type": "object", "required": ["step", "status"],
        "properties": {
          "step": {"type": "object"},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "error": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "required": ["execution_id", "scenario", "state", "locale", "viewport", "viewport_size", "color_scheme", "actions", "assertions", "state_before", "state_after", "locale_after", "outcome", "checks", "trace", "trace_digest", "console_errors", "page_errors", "request_failures", "failed_responses", "blocked_requests"],
      "properties": {
        "execution_id": {"type": "string", "pattern": "^design-[a-f0-9]{64}$"},
        "scenario": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1},
        "viewport": {"type": "string", "minLength": 1},
        "viewport_size": {
          "type": "object", "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}},
          "additionalProperties": false
        },
        "color_scheme": {"enum": ["light", "dark", "no-preference"]},
        "actions": {"$ref": "#/$defs/steps"},
        "assertions": {"$ref": "#/$defs/steps"},
        "state_before": {"type": ["boolean", "null"]},
        "state_after": {"type": "boolean"},
        "locale_after": {"type": "boolean"},
        "observed_locale": {"type": ["string", "null"]},
        "navigator_locale": {"type": "string"},
        "outcome": {"enum": ["passed", "failed"]},
        "checks": {"$ref": "#/$defs/checks"},
        "screenshot": {"type": "string", "pattern": "^design-[a-f0-9]{64}\\.png$"},
        "screenshot_digest": {"$ref": "#/$defs/digest"},
        "trace": {"type": "string", "pattern": "^design-[a-f0-9]{64}\\.zip$"},
        "trace_digest": {"$ref": "#/$defs/digest"},
        "console_errors": {"type": "array"},
        "page_errors": {"type": "array"},
        "request_failures": {"type": "array"},
        "failed_responses": {"type": "array"},
        "blocked_requests": {"type": "array"},
        "overflow": {"type": "object"},
        "keyboard": {"type": "object"},
        "zoom_200": {"type": "object"},
        "axe": {"type": "object"},
        "error": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"outcome": {"const": "passed"}}},
        "then": {
          "required": ["screenshot", "screenshot_digest"],
          "properties": {"state_after": {"const": true}, "locale_after": {"const": true}}
        }
      }],
      "additionalProperties": false
    }
  }
}
