{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-token-spec.schema.json",
  "title": "KillSlopRouter implementation color token evidence",
  "type": "object",
  "required": ["design_token_spec_version", "color_space", "harmony_strategy", "tokens", "tone_scales", "gamut_targets"],
  "properties": {
    "design_token_spec_version": {"const": 1},
    "color_space": {"enum": ["oklch", "hct"]},
    "harmony_strategy": {"type": "string", "minLength": 1},
    "tokens": {
      "type": "object",
      "required": [
        "canvas", "surface", "surface_raised",
        "text_primary", "text_secondary", "text_muted", "text_inverse",
        "border_subtle", "border_default", "border_strong", "focus_ring",
        "action_primary", "action_primary_hover", "action_primary_pressed", "action_disabled", "on_action",
        "accent", "accent_hover", "on_accent",
        "success", "on_success", "warning", "on_warning", "danger", "on_danger", "info", "on_info"
      ],
      "propertyNames": {
        "enum": [
          "canvas", "surface", "surface_raised",
          "text_primary", "text_secondary", "text_muted", "text_inverse",
          "border_subtle", "border_default", "border_strong", "focus_ring",
          "action_primary", "action_primary_hover", "action_primary_pressed", "action_disabled", "on_action",
          "accent", "accent_hover", "on_accent",
          "success", "on_success", "warning", "on_warning", "danger", "on_danger", "info", "on_info"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/token"}
    },
    "tone_scales": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "stops"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "stops": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/color"}}
        },
        "additionalProperties": false
      }
    },
    "gamut_targets": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "token": {
      "type": "object",
      "required": ["token", "value"],
      "properties": {
        "token": {"type": "string", "pattern": "^--[a-z0-9][a-z0-9-]*$"},
        "value": {"$ref": "#/$defs/color"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
