{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/bootstrap-receipt.schema.json",
  "title": "KillSlopRouter Bootstrap Receipt",
  "type": "object",
  "required": [
    "bootstrap_receipt_version",
    "status",
    "project_id",
    "locale",
    "project_root",
    "profile",
    "host_manifest",
    "safety",
    "next_actions",
    "receipt_digest"
  ],
  "properties": {
    "bootstrap_receipt_version": {"const": 1},
    "status": {"const": "manual_adapter_setup_required"},
    "project_id": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "project_root": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/file"},
    "host_manifest": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {
          "type": "object",
          "required": ["execution_mode"],
          "properties": {"execution_mode": {"const": "manual-only"}}
        }
      ]
    },
    "safety": {
      "type": "object",
      "required": [
        "approved_design_system",
        "arbitrary_profile_commands",
        "executable_adapters_authorized",
        "missing_execution_remains_manual_pending"
      ],
      "properties": {
        "approved_design_system": {"const": false},
        "arbitrary_profile_commands": {"const": false},
        "executable_adapters_authorized": {"const": false},
        "missing_execution_remains_manual_pending": {"const": true}
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "execution_mode": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
