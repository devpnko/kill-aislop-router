{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/playwright-scenarios.schema.json",
  "title": "KillSlopRouter Playwright Scenario Contract",
  "type": "object",
  "required": ["playwright_scenario_version", "scenarios"],
  "properties": {
    "playwright_scenario_version": {"const": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "path", "actions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^/"},
        "actions": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/action"}
        },
        "assertions": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/assertion"}
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["type", "locator"],
      "properties": {
        "type": {"enum": ["click", "fill", "press", "check", "uncheck", "select", "hover", "wait-for"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "value": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["fill", "press", "select"]}}},
          "then": {"required": ["value"]}
        }
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["visible", "hidden", "text", "value", "checked", "url", "count"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "value": {"type": ["string", "integer"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["visible", "hidden", "text", "value", "checked", "count"]}}},
          "then": {"required": ["locator"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["text", "value", "url"]}}},
          "then": {
            "required": ["value"],
            "properties": {"value": {"type": "string"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "count"}}},
          "then": {
            "required": ["value"],
            "properties": {"value": {"type": "integer", "minimum": 0}}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
