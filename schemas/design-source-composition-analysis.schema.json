{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-source-composition-analysis.schema.json",
  "title": "KillSlopRouter independent source composition analysis",
  "type": "object",
  "required": [
    "design_source_composition_analysis_version", "stage", "packet_digest",
    "pack_digest", "producer_state_digest", "capture_set_digest", "captures",
    "candidates"
  ],
  "properties": {
    "design_source_composition_analysis_version": {"const": 1},
    "stage": {"enum": ["direction-review", "color-review"]},
    "packet_digest": {"$ref": "#/$defs/digest"},
    "pack_digest": {"$ref": "#/$defs/digest"},
    "producer_state_digest": {"$ref": "#/$defs/digest"},
    "capture_set_digest": {"$ref": "#/$defs/digest"},
    "captures": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^capture-[0-9]{3}$"}
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id", "candidate_result_digest", "browser_result_digest",
        "capture_aliases", "dimensions", "source_composition_independence",
        "promotional_citation_firewall", "rationale", "structural_differences"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_result_digest": {"$ref": "#/$defs/digest"},
        "browser_result_digest": {"$ref": "#/$defs/digest"},
        "capture_aliases": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^capture-[0-9]{3}$"}
        },
        "dimensions": {"$ref": "#/$defs/strings"},
        "source_composition_independence": {
          "enum": ["pass", "fail", "inconclusive"]
        },
        "promotional_citation_firewall": {
          "enum": ["pass", "fail", "inconclusive"]
        },
        "rationale": {"type": "string", "minLength": 1},
        "structural_differences": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
