{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-profile-bindings.schema.json",
  "title": "KillSlopRouter approved profile bindings",
  "type": "object",
  "required": ["profile_bindings_version", "journey_identity", "project_id", "surface", "generated_at", "visual_intent", "visual_signature", "decision"],
  "properties": {
    "profile_bindings_version": {"const": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "project_id": {"type": "string", "minLength": 1},
    "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "visual_intent": {"type": "object"},
    "visual_signature": {"type": "object"},
    "reference_intelligence_binding": {"$ref": "#/$defs/reference-intelligence-binding"},
    "decision": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reference-trace": {
      "type": "object",
      "required": ["candidate_id", "trace_ids", "trace_digest", "grammar_ids", "reasoning_ids"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "trace_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "trace_digest": {"$ref": "#/$defs/digest"},
        "grammar_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reasoning_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "reference-intelligence-binding": {
      "type": "object",
      "required": [
        "reference_intelligence_binding_version", "authority_scope", "visual_authority_granted",
        "planning_target_id", "product_frame_digest", "pack_digest", "reference_pack_source_digest",
        "producer_run_id", "producer_state_digest", "producer_state_file_digest",
        "producer_selection_digest", "producer_result_digests",
        "reasoning_registry_digest", "selected_direction_trace", "selected_color_trace",
        "review_source_capture_set_digest", "direction_review_result_digest",
        "color_review_result_digest", "direction_source_composition_analysis_digest",
        "color_source_composition_analysis_digest", "binding_digest"
      ],
      "properties": {
        "reference_intelligence_binding_version": {"const": 1},
        "authority_scope": {"const": "discovery-evidence-only"},
        "visual_authority_granted": {"const": false},
        "planning_target_id": {"type": "string", "minLength": 1},
        "product_frame_digest": {"$ref": "#/$defs/digest"},
        "pack_digest": {"$ref": "#/$defs/digest"},
        "reference_pack_source_digest": {"$ref": "#/$defs/digest"},
        "producer_run_id": {"type": "string", "minLength": 1},
        "producer_state_digest": {"$ref": "#/$defs/digest"},
        "producer_state_file_digest": {"$ref": "#/$defs/digest"},
        "producer_selection_digest": {"$ref": "#/$defs/digest"},
        "producer_result_digests": {
          "type": "object",
          "required": ["reference-discovery", "reference-grammar", "reference-review"],
          "properties": {
            "reference-discovery": {"$ref": "#/$defs/digest"},
            "reference-grammar": {"$ref": "#/$defs/digest"},
            "reference-review": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        },
        "reasoning_registry_digest": {"$ref": "#/$defs/digest"},
        "selected_direction_trace": {"$ref": "#/$defs/reference-trace"},
        "selected_color_trace": {"$ref": "#/$defs/reference-trace"},
        "direction_review_result_digest": {"$ref": "#/$defs/digest"},
        "color_review_result_digest": {"$ref": "#/$defs/digest"},
        "review_source_capture_set_digest": {"$ref": "#/$defs/digest"},
        "direction_source_composition_analysis_digest": {"$ref": "#/$defs/digest"},
        "color_source_composition_analysis_digest": {"$ref": "#/$defs/digest"},
        "binding_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
