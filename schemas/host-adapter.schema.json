{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/host-adapter.schema.json",
  "title": "KillSlopRouter Host Adapter Manifest",
  "type": "object",
  "required": ["host_adapter_version", "allowed_providers", "granted_permissions", "providers"],
  "properties": {
    "host_adapter_version": {"const": 1},
    "allowed_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "granted_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["artifact:read", "evidence:write", "browser:control", "network:external"]
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["adapter", "strength", "capabilities", "permissions"],
      "properties": {
        "adapter": {
          "enum": ["kill-ai-slop-v1", "agent-json-v1", "skill-json-v1", "browser-json-v1", "manual-v1"]
        },
        "entrypoint": {"type": "string", "minLength": 1},
        "entrypoint_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "entrypoint_graph_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "adapter_root": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "strength": {"type": "integer", "minimum": 1, "maximum": 4},
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["artifact:read", "evidence:write", "browser:control", "network:external"]
          }
        },
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 900000},
        "settings": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"enum": ["agent-json-v1", "skill-json-v1", "browser-json-v1"]}}},
          "then": {"required": ["entrypoint", "entrypoint_digest"]}
        },
        {
          "if": {"properties": {"adapter": {"const": "kill-ai-slop-v1"}}},
          "then": {"required": ["adapter_root", "entrypoint_digest"]}
        },
        {
          "if": {
            "properties": {
              "settings": {
                "properties": {"contract": {"const": "killsloprouter-codex-review-v1"}},
                "required": ["contract"]
              }
            },
            "required": ["settings"]
          },
          "then": {"required": ["entrypoint_graph_digest"]}
        },
        {
          "if": {
            "properties": {
              "settings": {
                "properties": {"contract": {"const": "killsloprouter-playwright-v1"}},
                "required": ["contract"]
              }
            },
            "required": ["settings"]
          },
          "then": {"required": ["entrypoint_graph_digest"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
