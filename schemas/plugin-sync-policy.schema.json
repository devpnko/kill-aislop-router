{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/plugin-sync-policy.schema.json",
  "title": "KillSlopRouter account plugin sync policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_sync_version", "mode", "accounts"],
  "properties": {
    "plugin_sync_version": { "const": 1 },
    "mode": { "enum": ["shared", "per-account"] },
    "accounts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "description": "Absolute existing Codex account home below the selected user home." }
    }
  },
  "allOf": [{
    "if": { "properties": { "mode": { "const": "shared" } } },
    "then": { "properties": { "accounts": { "minItems": 1 } } }
  }]
}
