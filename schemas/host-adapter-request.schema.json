{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/host-adapter-request.schema.json",
  "title": "KillSlopRouter JSON Host Adapter Request",
  "type": "object",
  "required": [
    "host_adapter_request_version",
    "run_id",
    "journey_identity",
    "participant",
    "attempt",
    "packet",
    "packets",
    "creator",
    "scope",
    "artifacts",
    "prior_results",
    "output_directory",
    "permission_scopes",
    "settings"
  ],
  "properties": {
    "host_adapter_request_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "baseline_lineage": {"$ref": "baseline-lineage.schema.json"},
    "participant": {"$ref": "participant.schema.json"},
    "attempt": {"type": "integer", "minimum": 1},
    "packet": {"type": "object"},
    "packets": {"type": "array", "items": {"type": "object"}},
    "creator": {"type": "object"},
    "scope": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "prior_results": {"type": "array", "items": {"type": "object"}},
    "output_directory": {"type": "string", "minLength": 1},
    "permission_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["artifact:read", "evidence:write", "browser:control", "network:external"]
      }
    },
    "settings": {"type": "object"},
    "playwright_authority": {"$ref": "#/$defs/playwright_authority"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "settings": {
            "type": "object",
            "required": ["contract"],
            "properties": {"contract": {"const": "killsloprouter-playwright-v1"}}
          }
        }
      },
      "then": {
        "required": ["playwright_authority"],
        "properties": {
          "settings": {
            "required": [
              "runtime_root", "runtime_digest", "runtime_physical_identity_digest"
            ],
            "properties": {
              "runtime_root": {"type": "string", "minLength": 1},
              "runtime_digest": {"$ref": "#/$defs/digest"},
              "runtime_physical_identity_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "settings": {
            "type": "object",
            "required": ["contract"],
            "properties": {"contract": {"const": "killsloprouter-codex-review-v1"}}
          }
        }
      },
      "then": {
        "properties": {
          "settings": {
            "required": [
              "runtime_path", "runtime_digest", "runtime_physical_identity_digest",
              "runtime_root", "runtime_root_digest", "runtime_root_physical_identity_digest"
            ],
            "properties": {
              "runtime_path": {"type": "string", "minLength": 1},
              "runtime_digest": {"$ref": "#/$defs/digest"},
              "runtime_physical_identity_digest": {"$ref": "#/$defs/digest"},
              "runtime_root": {"type": "string", "minLength": 1},
              "runtime_root_digest": {"$ref": "#/$defs/digest"},
              "runtime_root_physical_identity_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "playwright_authority": {
      "type": "object",
      "required": [
        "playwright_child_authority_version", "runtime_digest",
        "runtime_source_physical_identity_digest", "runtime_seal_physical_identity_digest", "scenario",
        "baselines", "authority_digest"
      ],
      "properties": {
        "playwright_child_authority_version": {"const": 1},
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "runtime_source_physical_identity_digest": {"$ref": "#/$defs/digest"},
        "runtime_seal_physical_identity_digest": {"$ref": "#/$defs/digest"},
        "scenario": {
          "type": "object",
          "required": ["digest", "bytes", "physical_identity_digest", "source_base64"],
          "properties": {
            "digest": {"$ref": "#/$defs/digest"},
            "bytes": {"type": "integer", "minimum": 1},
            "physical_identity_digest": {"$ref": "#/$defs/digest"},
            "source_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
          },
          "additionalProperties": false
        },
        "baselines": {
          "type": "object",
          "required": ["directory_digest", "physical_identity_digest", "total_bytes", "files"],
          "properties": {
            "directory_digest": {"$ref": "#/$defs/digest"},
            "physical_identity_digest": {"$ref": "#/$defs/digest"},
            "total_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name", "bytes", "digest", "physical_identity_digest", "source_base64"
                ],
                "properties": {
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+[.]png$"},
                  "bytes": {"type": "integer", "minimum": 0},
                  "digest": {"$ref": "#/$defs/digest"},
                  "physical_identity_digest": {"$ref": "#/$defs/digest"},
                  "source_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "authority_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
