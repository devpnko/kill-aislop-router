{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/automation-step-receipt.schema.json",
  "title": "KillSlopRouter Automation Step Receipt",
  "type": "object",
  "required": [
    "automation_step_receipt_version",
    "run_id",
    "step_id",
    "status",
    "attempt",
    "generated_at",
    "payload",
    "receipt_digest"
  ],
  "properties": {
    "automation_step_receipt_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "step_id": {
      "enum": [
        "plan",
        "planning-verification",
        "audit-init",
        "dispatch",
        "execution",
        "result-ingest",
        "scanner-triage",
        "conflict-adjudication",
        "finalize"
      ]
    },
    "status": {"enum": ["completed", "manual_pending", "blocked"]},
    "attempt": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
