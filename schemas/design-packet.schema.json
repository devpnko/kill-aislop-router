{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-packet.schema.json",
  "title": "KillSlopRouter design dispatch packet",
  "type": "object",
  "required": [
    "design_packet_version", "packet_id", "run_id", "stage_id", "provider", "journey_identity", "participant",
    "assigned_capabilities", "minimum_strength", "required_permissions",
    "evidence_contract", "design_task", "packet_digest"
  ],
  "properties": {
    "design_packet_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "participant": {"$ref": "participant.schema.json"},
    "stage_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": ["id", "kind", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "resolved_to": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assigned_capabilities": {"$ref": "#/$defs/strings"},
    "minimum_strength": {"type": "integer", "minimum": 1, "maximum": 4},
    "required_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "browser:control", "reference-evidence:read", "network:external"]}
    },
    "forbidden_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "browser:control", "reference-evidence:read", "network:external"]}
    },
    "evidence_contract": {
      "type": "object",
      "required": ["required_viewports", "required_checks"],
      "properties": {
        "required_viewports": {"$ref": "#/$defs/optional-strings"},
        "required_checks": {"$ref": "#/$defs/optional-strings"}
      },
      "additionalProperties": false
    },
    "design_task": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "constraint_audit": {"$ref": "design-constraint-audit.schema.json#/$defs/packet"},
        "constraint_evidence": {"$ref": "design-constraint-audit.schema.json#/$defs/sources"},
        "constraint_released_proposals": {"$ref": "design-constraint-audit.schema.json#/properties/released_proposals"},
        "reference_candidate_scope": {
          "type": "object",
          "required": ["binding_digest", "task_frame_digest", "primary_only", "source_craft_parity_assessed"],
          "properties": {
            "binding_digest": {"$ref": "#/$defs/digest"},
            "task_frame_digest": {"$ref": "#/$defs/digest"},
            "primary_only": {"const": true},
            "source_craft_parity_assessed": {"const": false}
          },
          "additionalProperties": false
        },
        "kind": {"enum": ["direction-candidate", "browser-evidence", "direction-review", "color-candidate", "color-review",
          "specimen-review", "source-craft-review"]},
        "source_craft_review": {"$ref": "source-craft-authority.schema.json#/$defs/packet"},
        "reviewer_actor_id": {"type": "string", "minLength": 1},
        "source_craft_cohort_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "reference_delivery": {
          "type": "object",
          "required": ["status", "intent_status", "owner_decision_digest", "source_derived_craft"],
          "properties": {
            "status": {"const": "not_bound"},
            "intent_status": {"const": "owner-opt-out"},
            "owner_decision_digest": {"$ref": "#/$defs/digest"},
            "source_derived_craft": {"const": false}
          },
          "additionalProperties": false
        },
        "reference_intelligence": {
          "type": "object",
          "required": [
            "audience", "pack_digest", "authority_scope", "reasoning_registry_digest",
            "source_pixels_included", "source_identities_included",
            "source_evidence_descriptors_included", "source_pixels_available_to_participant",
            "source_pixels_exposed_to_downstream_creator", "required_design_checks",
            "design_check_contracts", "projection_digest"
          ],
          "properties": {
            "audience": {"enum": ["creator", "independent-reviewer",
              "specimen-reviewer"]},
            "pack_digest": {"$ref": "#/$defs/digest"},
            "authority_scope": {"const": "discovery-evidence-only"},
            "reasoning_registry_digest": {"$ref": "#/$defs/digest"},
            "source_pixels_included": {"const": false},
            "source_identities_included": {"const": false},
            "source_evidence_descriptors_included": {"type": "boolean"},
            "source_pixels_available_to_participant": {"type": "boolean"},
            "source_pixels_exposed_to_downstream_creator": {"const": false},
            "review_source_authority": {
              "$ref": "design-exploration-run.schema.json#/$defs/reviewSourceAuthority"
            },
            "required_design_checks": {"$ref": "#/$defs/strings"},
            "design_check_contracts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"oneOf": [
                {"$ref": "human-design-reasoning-registry.schema.json#/$defs/design_check"},
                {"$ref": "#/$defs/component_craft_check"}
              ]}
            },
            "projection_digest": {"$ref": "#/$defs/digest"}
          },
          "allOf": [
            {
              "if": {
                "properties": {"audience": {"const": "independent-reviewer"}},
                "required": ["audience"]
              },
              "then": {
                "required": ["review_source_authority"],
                "properties": {
                  "source_evidence_descriptors_included": {"const": true},
                  "source_pixels_available_to_participant": {"const": true}
                }
              },
              "else": {
                "not": {"required": ["review_source_authority"]},
                "properties": {
                  "source_evidence_descriptors_included": {"const": false},
                  "source_pixels_available_to_participant": {"const": false}
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "dependentRequired": {
        "constraint_evidence": ["constraint_audit"],
        "constraint_released_proposals": ["constraint_audit"]
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "source-craft-review"}}},
          "then": {
            "required": ["source_craft_review", "source_craft_cohort_bindings", "reviewer_actor_id"],
            "not": {"anyOf": [{"required": ["reference_intelligence"]}, {"required": ["constraint_audit"]}, {"required": ["visual_goal_contract"]}]}
          },
          "else": {"not": {"anyOf": [{"required": ["source_craft_review"]}, {"required": ["source_craft_cohort_bindings"]}, {"required": ["reviewer_actor_id"]}]}}
        },
        {
          "if": {"properties": {"kind": {"const": "browser-evidence"}}},
          "then": {"not": {"required": ["constraint_audit"]}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["direction-review", "color-review", "specimen-review"]}}},
          "then": {
            "if": {"required": ["constraint_audit"]},
            "then": {
              "required": ["constraint_evidence", "constraint_released_proposals"],
              "properties": {"constraint_audit": {"required": ["review_inventory"]}}
            }
          },
          "else": {
            "not": {"anyOf": [
              {"required": ["constraint_evidence"]}, {"required": ["constraint_released_proposals"]}
            ]},
            "properties": {"constraint_audit": {"not": {"required": ["review_inventory"]}}}
          }
        }
      ],
      "additionalProperties": true
    },
    "packet_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "component_craft_check": {
      "type": "object",
      "required": ["check_id", "lens_ids", "pass_condition", "required_evidence", "stages", "failure_code"],
      "properties": {
        "check_id": {"const": "component-craft-and-reflow"},
        "lens_ids": {"const": ["expression-follows-promise", "responsive-reprioritization"]},
        "pass_condition": {"type": "string", "minLength": 1},
        "required_evidence": {"const": ["component-craft-spec", "prototype", "playwright-evidence", "review-report"]},
        "stages": {"const": ["direction-review", "color-review"]},
        "failure_code": {"const": "reference-check-failed:component-craft-and-reflow"}
      },
      "additionalProperties": false
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "optional-strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"design_task": {"properties": {"kind": {"const": "source-craft-review"}}, "required": ["kind"]}}},
      "then": {
        "required": ["forbidden_permissions"],
        "properties": {
          "required_permissions": {"contains": {"const": "reference-evidence:read"}, "not": {"contains": {"const": "network:external"}}},
          "forbidden_permissions": {"contains": {"const": "network:external"}, "not": {"contains": {"const": "reference-evidence:read"}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage_id": {"const": "browser-evidence"},
          "forbidden_permissions": {
            "contains": {"const": "network:external"}
          }
        },
        "required": ["stage_id", "forbidden_permissions"]
      },
      "then": {
        "properties": {
          "provider": {
            "required": ["resolved_to"],
            "properties": {
              "resolved_to": {"const": "official:playwright-browser-v1"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_permissions": {"contains": {"const": "network:external"}}
        },
        "required": ["required_permissions"]
      },
      "then": {
        "properties": {
          "forbidden_permissions": {
            "not": {"contains": {"const": "network:external"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_permissions": {"contains": {"const": "reference-evidence:read"}}
        },
        "required": ["required_permissions"]
      },
      "then": {
        "properties": {
          "forbidden_permissions": {
            "not": {"contains": {"const": "reference-evidence:read"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {"required": ["reference_intelligence"]}
        },
        "required": ["design_task"]
      },
      "then": {
        "required": ["forbidden_permissions"],
        "properties": {
          "required_permissions": {
            "not": {"contains": {"const": "network:external"}}
          },
          "forbidden_permissions": {
            "contains": {"const": "network:external"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {
            "required": ["reference_intelligence"],
            "properties": {
              "reference_intelligence": {
                "properties": {"audience": {"const": "independent-reviewer"}},
                "required": ["audience"]
              }
            }
          }
        },
        "required": ["design_task"]
      },
      "then": {
        "properties": {
          "design_task": {
            "properties": {
              "kind": {"enum": ["direction-review", "color-review"]}
            }
          },
          "required_permissions": {
            "contains": {"const": "reference-evidence:read"}
          },
          "forbidden_permissions": {
            "not": {"contains": {"const": "reference-evidence:read"}}
          }
        }
      },
      "else": {
        "if": {
          "not": {
            "properties": {
              "design_task": {"properties": {"kind": {"const": "source-craft-review"}}, "required": ["kind"]}
            },
            "required": ["design_task"]
          }
        },
        "then": {
          "properties": {
            "required_permissions": {
              "not": {"contains": {"const": "reference-evidence:read"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {
            "required": ["reference_intelligence"],
            "properties": {
              "reference_intelligence": {
                "properties": {"audience": {"const": "creator"}},
                "required": ["audience"]
              }
            }
          }
        },
        "required": ["design_task"]
      },
      "then": {
        "properties": {
          "design_task": {
            "properties": {
              "kind": {"enum": ["direction-candidate", "color-candidate"]}
            }
          },
          "forbidden_permissions": {
            "contains": {"const": "reference-evidence:read"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {
            "properties": {
              "kind": {
                "const": "specimen-review"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "design_task": {
            "properties": {
              "reference_intelligence": {
                "properties": {
                  "audience": {
                    "const": "specimen-reviewer"
                  }
                }
              }
            }
          },
          "required_permissions": {
            "not": {
              "contains": {
                "const": "reference-evidence:read"
              }
            }
          },
          "forbidden_permissions": {
            "contains": {
              "const": "reference-evidence:read"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
