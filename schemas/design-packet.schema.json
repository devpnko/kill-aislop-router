{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-packet.schema.json",
  "title": "KillSlopRouter design dispatch packet",
  "type": "object",
  "required": [
    "design_packet_version", "packet_id", "run_id", "stage_id", "provider", "journey_identity", "participant",
    "assigned_capabilities", "minimum_strength", "required_permissions",
    "evidence_contract", "design_task", "packet_digest"
  ],
  "properties": {
    "design_packet_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "participant": {"$ref": "participant.schema.json"},
    "stage_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": ["id", "kind", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "resolved_to": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assigned_capabilities": {"$ref": "#/$defs/strings"},
    "minimum_strength": {"type": "integer", "minimum": 1, "maximum": 4},
    "required_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "browser:control", "reference-evidence:read", "network:external"]}
    },
    "forbidden_permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["artifact:read", "evidence:write", "browser:control", "reference-evidence:read", "network:external"]}
    },
    "evidence_contract": {
      "type": "object",
      "required": ["required_viewports", "required_checks"],
      "properties": {
        "required_viewports": {"$ref": "#/$defs/optional-strings"},
        "required_checks": {"$ref": "#/$defs/optional-strings"}
      },
      "additionalProperties": false
    },
    "design_task": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["direction-candidate", "browser-evidence", "direction-review", "color-candidate", "color-review"]},
        "reference_intelligence": {
          "type": "object",
          "required": [
            "audience", "pack_digest", "authority_scope", "reasoning_registry_digest",
            "source_pixels_included", "source_identities_included",
            "source_evidence_descriptors_included", "source_pixels_available_to_participant",
            "source_pixels_exposed_to_downstream_creator", "required_design_checks",
            "design_check_contracts", "projection_digest"
          ],
          "properties": {
            "audience": {"enum": ["creator", "independent-reviewer"]},
            "pack_digest": {"$ref": "#/$defs/digest"},
            "authority_scope": {"const": "discovery-evidence-only"},
            "reasoning_registry_digest": {"$ref": "#/$defs/digest"},
            "source_pixels_included": {"const": false},
            "source_identities_included": {"const": false},
            "source_evidence_descriptors_included": {"type": "boolean"},
            "source_pixels_available_to_participant": {"type": "boolean"},
            "source_pixels_exposed_to_downstream_creator": {"const": false},
            "review_source_authority": {
              "$ref": "design-exploration-run.schema.json#/$defs/reviewSourceAuthority"
            },
            "required_design_checks": {"$ref": "#/$defs/strings"},
            "design_check_contracts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "human-design-reasoning-registry.schema.json#/$defs/design_check"}
            },
            "projection_digest": {"$ref": "#/$defs/digest"}
          },
          "allOf": [
            {
              "if": {
                "properties": {"audience": {"const": "independent-reviewer"}},
                "required": ["audience"]
              },
              "then": {
                "required": ["review_source_authority"],
                "properties": {
                  "source_evidence_descriptors_included": {"const": true},
                  "source_pixels_available_to_participant": {"const": true}
                }
              },
              "else": {
                "not": {"required": ["review_source_authority"]},
                "properties": {
                  "source_evidence_descriptors_included": {"const": false},
                  "source_pixels_available_to_participant": {"const": false}
                }
              }
            }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "packet_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "optional-strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage_id": {"const": "browser-evidence"},
          "forbidden_permissions": {
            "contains": {"const": "network:external"}
          }
        },
        "required": ["stage_id", "forbidden_permissions"]
      },
      "then": {
        "properties": {
          "provider": {
            "required": ["resolved_to"],
            "properties": {
              "resolved_to": {"const": "official:playwright-browser-v1"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_permissions": {"contains": {"const": "network:external"}}
        },
        "required": ["required_permissions"]
      },
      "then": {
        "properties": {
          "forbidden_permissions": {
            "not": {"contains": {"const": "network:external"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required_permissions": {"contains": {"const": "reference-evidence:read"}}
        },
        "required": ["required_permissions"]
      },
      "then": {
        "properties": {
          "forbidden_permissions": {
            "not": {"contains": {"const": "reference-evidence:read"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {"required": ["reference_intelligence"]}
        },
        "required": ["design_task"]
      },
      "then": {
        "required": ["forbidden_permissions"],
        "properties": {
          "required_permissions": {
            "not": {"contains": {"const": "network:external"}}
          },
          "forbidden_permissions": {
            "contains": {"const": "network:external"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {
            "required": ["reference_intelligence"],
            "properties": {
              "reference_intelligence": {
                "properties": {"audience": {"const": "independent-reviewer"}},
                "required": ["audience"]
              }
            }
          }
        },
        "required": ["design_task"]
      },
      "then": {
        "properties": {
          "design_task": {
            "properties": {
              "kind": {"enum": ["direction-review", "color-review"]}
            }
          },
          "required_permissions": {
            "contains": {"const": "reference-evidence:read"}
          },
          "forbidden_permissions": {
            "not": {"contains": {"const": "reference-evidence:read"}}
          }
        }
      },
      "else": {
        "properties": {
          "required_permissions": {
            "not": {"contains": {"const": "reference-evidence:read"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "design_task": {
            "required": ["reference_intelligence"],
            "properties": {
              "reference_intelligence": {
                "properties": {"audience": {"const": "creator"}},
                "required": ["audience"]
              }
            }
          }
        },
        "required": ["design_task"]
      },
      "then": {
        "properties": {
          "design_task": {
            "properties": {
              "kind": {"enum": ["direction-candidate", "color-candidate"]}
            }
          },
          "forbidden_permissions": {
            "contains": {"const": "reference-evidence:read"}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
