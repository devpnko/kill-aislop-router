{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/visual-intent-receipt.schema.json",
  "title": "KillSlopRouter Visual Intent Authority Receipt",
  "type": "object",
  "required": [
    "visual_intent_receipt_version",
    "project_id",
    "surface",
    "status",
    "intent",
    "authority",
    "evidence"
  ],
  "properties": {
    "visual_intent_receipt_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
    "status": {"const": "approved"},
    "intent": {"$ref": "#/$defs/intent"},
    "authority": {
      "type": "object",
      "required": ["kind", "authority_id", "basis", "decided_at"],
      "properties": {
        "kind": {"enum": ["project-contract", "brand-system", "owner-direction", "approved-reference"]},
        "authority_id": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "digest"],
        "properties": {
          "kind": {"enum": ["project-contract", "brand-system", "owner-direction", "approved-reference", "approved-artifact", "owner-approval"]},
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["mode", "editorial_treatment", "editorial_scope", "energy", "depth", "preserve", "avoid"],
      "properties": {
        "mode": {"enum": ["product-native", "brand-expressive", "editorial", "campaign", "reference-led"]},
        "editorial_treatment": {"enum": ["forbidden", "bounded", "required"]},
        "editorial_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "energy": {"enum": ["quiet", "balanced", "high"]},
        "depth": {"enum": ["flat", "layered", "immersive"]},
        "preserve": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "editorial"}}},
          "then": {"properties": {"editorial_treatment": {"const": "required"}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "required"}}},
          "then": {"properties": {"mode": {"const": "editorial"}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "bounded"}}},
          "then": {"properties": {"editorial_scope": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "forbidden"}}},
          "then": {"properties": {"editorial_scope": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
