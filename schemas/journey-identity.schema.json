{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/journey-identity.schema.json",
  "title": "KillSlopRouter Journey Identity",
  "type": "object",
  "required": [
    "journey_identity_version",
    "orchestrator_id",
    "orchestrator_version",
    "display_name",
    "canonical_entrypoint",
    "invocation",
    "run_id",
    "presentation",
    "identity_digest"
  ],
  "properties": {
    "journey_identity_version": {"const": 1},
    "orchestrator_id": {"const": "kill-slop-router"},
    "orchestrator_version": {"type": "string", "minLength": 1},
    "display_name": {"const": "KillSlopRouter"},
    "canonical_entrypoint": {"const": "killsloprouter:kill-slop-router"},
    "invocation": {"enum": ["explicit", "implicit", "resume", "legacy-migrated"]},
    "run_id": {"type": "string", "minLength": 1},
    "presentation": {
      "type": "object",
      "required": ["active_workflow", "participant_rule"],
      "properties": {
        "active_workflow": {"const": "KillSlopRouter"},
        "participant_rule": {"const": "internal-role-only"}
      },
      "additionalProperties": false
    },
    "identity_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
