{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/component-craft-implementation.schema.json",
  "title": "KillSlopRouter component-craft-implementation v1",
  "type": "object",
  "required": [
    "component_craft_version",
    "contract_digest",
    "parts",
    "relationships"
  ],
  "properties": {
    "component_craft_version": {
      "const": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "part_id",
          "selector"
        ],
        "properties": {
          "part_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "selector": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "decision_digest",
          "implementation"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "decision_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
