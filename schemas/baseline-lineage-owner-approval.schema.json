{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/baseline-lineage-owner-approval.schema.json",
  "title": "KillSlopRouter External Planning Approval For A Lineage Candidate",
  "type": "object",
  "required": [
    "status",
    "owner_id",
    "lineage_id",
    "baseline_lineage_digest",
    "decision_scope",
    "parent_promotion",
    "candidate",
    "decided_at"
  ],
  "properties": {
    "status": {"const": "approved"},
    "owner_id": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "minLength": 1},
    "baseline_lineage_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision_scope": {"const": "candidate-slice-binding"},
    "parent_promotion": {"const": false},
    "candidate": {
      "type": "object",
      "required": ["id", "version", "slice_id", "artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "slice_id": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
