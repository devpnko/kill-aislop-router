{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/project-profile.schema.json",
  "title": "KillSlopRouter Project Profile",
  "type": "object",
  "required": ["profile_version", "project_id", "approved_design_system", "local_adapters"],
  "properties": {
    "profile_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "default_locale": {"type": "string", "minLength": 2},
    "approved_design_system": {"type": "boolean"},
    "tool_lock": {"type": "string"},
    "local_adapters": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["target", "status"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
              "version": {"type": "string"},
              "executor": {"type": "string", "minLength": 1},
              "strength": {"type": "integer", "minimum": 1, "maximum": 4},
              "capabilities": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "independent_from_creator": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "external_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
          "version": {"type": "string"},
          "root": {"type": "string", "minLength": 1},
          "executor": {"type": "string", "minLength": 1},
          "strength": {"type": "integer", "minimum": 1, "maximum": 4},
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "independent_from_creator": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "fallback_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "status", "strength", "capabilities", "independent_from_creator"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"enum": ["local", "external", "agent", "browser"]},
            "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
            "version": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "executor": {"type": "string", "minLength": 1},
            "strength": {"type": "integer", "minimum": 1, "maximum": 4},
            "capabilities": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "independent_from_creator": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    },
    "surface_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "creator": {"type": "string"},
          "creator_by_direction": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "exclude_tools": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "high_risk_gates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "browser": {"type": "string", "minLength": 1},
        "required_viewports": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
