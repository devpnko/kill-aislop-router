{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/project-profile.schema.json",
  "title": "KillSlopRouter Project Profile",
  "type": "object",
  "required": ["profile_version", "project_id", "surface_contract", "approved_design_system", "local_adapters"],
  "properties": {
    "profile_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "default_locale": {"type": "string", "minLength": 2},
    "surface_contract": {
      "type": "object",
      "required": ["surface_contract_version", "primary", "allowed", "artifact_bindings"],
      "properties": {
        "surface_contract_version": {"const": 1},
        "primary": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]}
        },
        "artifact_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["root", "surface"],
            "properties": {
              "root": {"type": "string", "minLength": 1},
              "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "visual_intents": {
      "type": "object",
      "propertyNames": {
        "enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]
      },
      "additionalProperties": {"$ref": "#/$defs/visual-intent"}
    },
    "visual_signatures": {
      "type": "object",
      "propertyNames": {
        "enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]
      },
      "additionalProperties": {"$ref": "#/$defs/visual-signature"}
    },
    "approved_design_system": {"type": "boolean"},
    "design_system": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "approved", "deprecated"]},
        "authority_receipt": {"type": "string", "minLength": 1},
        "authority_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_scope_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {"required": ["authority_receipt", "authority_digest"]}
        }
      ],
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "receipt": {"type": "string", "minLength": 1},
        "surface_receipts": {
          "type": "object",
          "propertyNames": {
            "enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]
          },
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [
        {"required": ["receipt"]},
        {"required": ["surface_receipts"]}
      ],
      "additionalProperties": false
    },
    "tool_lock": {"type": "string"},
    "local_adapters": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["target", "status"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
              "version": {"type": "string"},
              "executor": {"type": "string", "minLength": 1},
              "strength": {"type": "integer", "minimum": 1, "maximum": 4},
              "capabilities": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "independent_from_creator": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "external_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
          "version": {"type": "string"},
          "root": {"type": "string", "minLength": 1},
          "executor": {"type": "string", "minLength": 1},
          "strength": {"type": "integer", "minimum": 1, "maximum": 4},
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "independent_from_creator": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "fallback_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "status", "strength", "capabilities", "independent_from_creator"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"enum": ["local", "external", "agent", "browser"]},
            "status": {"enum": ["available", "routable", "unavailable", "disabled"]},
            "version": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "executor": {"type": "string", "minLength": 1},
            "strength": {"type": "integer", "minimum": 1, "maximum": 4},
            "capabilities": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "independent_from_creator": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    },
    "surface_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "creator": {"type": "string"},
          "creator_by_direction": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "exclude_tools": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "high_risk_gates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "browser": {"type": "string", "minLength": 1},
        "required_viewports": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "visual-intent": {
      "type": "object",
      "required": [
        "visual_intent_version",
        "status",
        "mode",
        "editorial_treatment",
        "editorial_scope",
        "energy",
        "depth",
        "preserve",
        "avoid"
      ],
      "properties": {
        "visual_intent_version": {"const": 1},
        "status": {"enum": ["unresolved", "approved"]},
        "mode": {"enum": ["unresolved", "product-native", "brand-expressive", "editorial", "campaign", "reference-led"]},
        "editorial_treatment": {"enum": ["forbidden", "bounded", "required"]},
        "editorial_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "energy": {"enum": ["preserve", "quiet", "balanced", "high"]},
        "depth": {"enum": ["preserve", "flat", "layered", "immersive"]},
        "preserve": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_receipt": {"type": "string", "minLength": 1},
        "authority_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {
            "required": ["authority_receipt", "authority_digest"],
            "properties": {
              "mode": {"enum": ["product-native", "brand-expressive", "editorial", "campaign", "reference-led"]},
              "energy": {"enum": ["quiet", "balanced", "high"]},
              "depth": {"enum": ["flat", "layered", "immersive"]}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unresolved"}}},
          "then": {
            "properties": {
              "mode": {"const": "unresolved"},
              "editorial_treatment": {"const": "forbidden"},
              "editorial_scope": {"maxItems": 0},
              "energy": {"const": "preserve"},
              "depth": {"const": "preserve"}
            },
            "not": {
              "anyOf": [
                {"required": ["authority_receipt"]},
                {"required": ["authority_digest"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "editorial"}}},
          "then": {"properties": {"editorial_treatment": {"const": "required"}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "required"}}},
          "then": {"properties": {"mode": {"const": "editorial"}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "bounded"}}},
          "then": {"properties": {"editorial_scope": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"editorial_treatment": {"const": "forbidden"}}},
          "then": {"properties": {"editorial_scope": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "color-reference": {
      "type": "object",
      "required": ["value", "usage"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "usage": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "semantic-color-reference": {
      "type": "object",
      "required": ["role", "value", "usage"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "usage": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "font-reference": {
      "type": "object",
      "required": ["family", "role"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "visual-signature": {
      "type": "object",
      "required": [
        "visual_signature_version",
        "status",
        "palette",
        "typography",
        "density",
        "shape",
        "elevation",
        "imagery",
        "motion",
        "style_keywords",
        "forbidden_transformations"
      ],
      "properties": {
        "visual_signature_version": {"const": 1},
        "status": {"enum": ["unresolved", "approved"]},
        "palette": {
          "type": "object",
          "required": ["primary", "accent", "background", "surface", "text", "semantic"],
          "properties": {
            "primary": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/color-reference"}},
            "accent": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/color-reference"}},
            "background": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/color-reference"}},
            "surface": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/color-reference"}},
            "text": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/color-reference"}},
            "semantic": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semantic-color-reference"}}
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "required": ["families", "scale", "weights", "treatments"],
          "properties": {
            "families": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/font-reference"}},
            "scale": {"type": "string", "minLength": 1},
            "weights": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "treatments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "density": {
          "type": "object",
          "required": ["mode", "characteristics"],
          "properties": {
            "mode": {"enum": ["preserve", "compact", "balanced", "spacious", "mixed"]},
            "characteristics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "shape": {
          "type": "object",
          "required": ["radii", "geometry", "strokes"],
          "properties": {
            "radii": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "geometry": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "strokes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "elevation": {
          "type": "object",
          "required": ["strategy", "shadows", "separation"],
          "properties": {
            "strategy": {"enum": ["preserve", "flat", "border-led", "layered", "immersive", "mixed"]},
            "shadows": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "separation": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "imagery": {
          "type": "object",
          "required": ["strategy", "characteristics"],
          "properties": {
            "strategy": {"enum": ["preserve", "none", "functional", "brand", "editorial", "campaign", "mixed"]},
            "characteristics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": ["intensity", "characteristics"],
          "properties": {
            "intensity": {"enum": ["preserve", "none", "restrained", "balanced", "expressive"]},
            "characteristics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "style_keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_transformations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_receipt": {"type": "string", "minLength": 1},
        "authority_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {
            "required": ["authority_receipt", "authority_digest"],
            "properties": {
              "palette": {
                "properties": {
                  "primary": {"minItems": 1},
                  "background": {"minItems": 1},
                  "surface": {"minItems": 1},
                  "text": {"minItems": 1}
                }
              },
              "typography": {
                "properties": {
                  "families": {"minItems": 1},
                  "scale": {"not": {"const": "preserve"}},
                  "weights": {"minItems": 1},
                  "treatments": {"minItems": 1}
                }
              },
              "density": {
                "properties": {
                  "mode": {"enum": ["compact", "balanced", "spacious", "mixed"]},
                  "characteristics": {"minItems": 1}
                }
              },
              "shape": {
                "properties": {
                  "radii": {"minItems": 1},
                  "geometry": {"minItems": 1},
                  "strokes": {"minItems": 1}
                }
              },
              "elevation": {
                "properties": {
                  "strategy": {"enum": ["flat", "border-led", "layered", "immersive", "mixed"]},
                  "shadows": {"minItems": 1},
                  "separation": {"minItems": 1}
                }
              },
              "imagery": {
                "properties": {
                  "strategy": {"enum": ["none", "functional", "brand", "editorial", "campaign", "mixed"]},
                  "characteristics": {"minItems": 1}
                }
              },
              "motion": {
                "properties": {
                  "intensity": {"enum": ["none", "restrained", "balanced", "expressive"]},
                  "characteristics": {"minItems": 1}
                }
              },
              "style_keywords": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unresolved"}}},
          "then": {
            "properties": {
              "palette": {
                "properties": {
                  "primary": {"maxItems": 0},
                  "accent": {"maxItems": 0},
                  "background": {"maxItems": 0},
                  "surface": {"maxItems": 0},
                  "text": {"maxItems": 0},
                  "semantic": {"maxItems": 0}
                }
              },
              "typography": {
                "properties": {
                  "families": {"maxItems": 0},
                  "scale": {"const": "preserve"},
                  "weights": {"maxItems": 0},
                  "treatments": {"maxItems": 0}
                }
              },
              "density": {"properties": {"mode": {"const": "preserve"}, "characteristics": {"maxItems": 0}}},
              "shape": {"properties": {"radii": {"maxItems": 0}, "geometry": {"maxItems": 0}, "strokes": {"maxItems": 0}}},
              "elevation": {"properties": {"strategy": {"const": "preserve"}, "shadows": {"maxItems": 0}, "separation": {"maxItems": 0}}},
              "imagery": {"properties": {"strategy": {"const": "preserve"}, "characteristics": {"maxItems": 0}}},
              "motion": {"properties": {"intensity": {"const": "preserve"}, "characteristics": {"maxItems": 0}}},
              "style_keywords": {"maxItems": 0}
            },
            "not": {
              "anyOf": [
                {"required": ["authority_receipt"]},
                {"required": ["authority_digest"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
