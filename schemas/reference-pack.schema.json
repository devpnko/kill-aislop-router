{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/reference-pack.schema.json",
  "title": "KillSlopRouter reference intelligence pack",
  "type": "object",
  "required": [
    "reference_pack_version", "run_id", "journey_identity", "project_id", "surface",
    "authority_scope", "planning_target_id", "product_frame_digest", "planning_frame",
    "selection", "references", "evidence_manifest", "reasoning_lenses", "verified_observations",
    "verified_hierarchy_reasoning", "verified_grammar", "ranking_policy",
    "downstream_contract", "provenance", "compiled_at", "pack_digest"
  ],
  "properties": {
    "reference_pack_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "journey_identity": {"$ref": "journey-identity.schema.json"},
    "project_id": {"$ref": "#/$defs/id"},
    "surface": {"enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]},
    "authority_scope": {"const": "discovery-evidence-only"},
    "planning_target_id": {"$ref": "#/$defs/id"},
    "product_frame_digest": {"$ref": "#/$defs/digest"},
    "planning_frame": {"$ref": "#/$defs/product_frame"},
    "selection": {
      "type": "object",
      "required": [
        "owner_id", "selection_digest", "anchor_reference_id",
        "supporting_reference_ids", "rationale"
      ],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "selection_digest": {"$ref": "#/$defs/digest"},
        "anchor_reference_id": {"$ref": "#/$defs/id"},
        "supporting_reference_ids": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "evidence_manifest": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_manifest_item"}
    },
    "reasoning_lenses": {
      "type": "array", "minItems": 8, "uniqueItems": true,
      "items": {"$ref": "#/$defs/lens"}
    },
    "verified_observations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/verified_observation"}
    },
    "verified_hierarchy_reasoning": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/hierarchy_reasoning"}
    },
    "verified_grammar": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/grammar"}
    },
    "ranking_policy": {
      "type": "object",
      "required": [
        "primary", "within_band", "unverified_or_conflicted_popularity",
        "popularity_cannot_affect", "signals"
      ],
      "properties": {
        "primary": {"const": "product-fit-band"},
        "within_band": {"const": "popularity-descending"},
        "unverified_or_conflicted_popularity": {"const": "rank-last-within-fit-band"},
        "popularity_cannot_affect": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["eligibility", "hard-gates", "owner-approval"]}
        },
        "signals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/ranking_signal"}
        }
      },
      "additionalProperties": false
    },
    "downstream_contract": {
      "type": "object",
      "required": [
        "source_pixels_included", "reasoning_registry_is_visual_authority",
        "visual_authority_granted", "visual_signature_granted",
        "design_creation_started", "exact_three_3x3_route_unchanged",
        "required_design_checks", "design_check_contracts",
        "reviewer_source_capture_readiness", "required_next_gate"
      ],
      "properties": {
        "source_pixels_included": {"const": false},
        "reasoning_registry_is_visual_authority": {"const": false},
        "visual_authority_granted": {"const": false},
        "visual_signature_granted": {"const": false},
        "design_creation_started": {"const": false},
        "exact_three_3x3_route_unchanged": {"const": true},
        "required_design_checks": {
          "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true,
          "items": {"enum": [
            "decision-inventory", "state-cardinality", "accent-role-budget",
            "comparison-slot-alignment", "risk-near-action", "density-by-cadence",
            "live-data-scaffolding", "state-completeness", "responsive-reprioritization",
            "promotional-citation-firewall", "source-composition-independence"
          ]}
        },
        "design_check_contracts": {
          "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true,
          "items": {"$ref": "human-design-reasoning-registry.schema.json#/$defs/design_check"}
        },
        "reviewer_source_capture_readiness": {
          "type": "object",
          "required": [
            "status", "capture_evidence_ids", "uncovered_reference_ids",
            "uncovered_observation_ids", "revalidate_on_design_start"
          ],
          "properties": {
            "status": {"enum": ["ready_at_compilation", "manual_pending"]},
            "capture_evidence_ids": {
              "type": "array", "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "uncovered_reference_ids": {
              "type": "array", "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "uncovered_observation_ids": {
              "type": "array", "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "revalidate_on_design_start": {"const": true}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "ready_at_compilation"}}},
              "then": {
                "properties": {
                  "capture_evidence_ids": {"minItems": 1},
                  "uncovered_reference_ids": {"maxItems": 0},
                  "uncovered_observation_ids": {"maxItems": 0}
                }
              },
              "else": {
                "anyOf": [
                  {"properties": {"uncovered_reference_ids": {"minItems": 1}}},
                  {"properties": {"uncovered_observation_ids": {"minItems": 1}}}
                ]
              }
            }
          ],
          "$comment": "Runtime recomputes this object from selected source-capture evidence and verified observation frame bindings, including deterministic sorted ID arrays; a caller claim is never trusted.",
          "additionalProperties": false
        },
        "required_next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "brief_digest", "reasoning_registry_version", "reasoning_registry_digest",
        "reasoning_registry_source_digest", "planning_digests", "rights_digest",
        "source_export_digests", "result_digests", "selection_scope_digest"
      ],
      "properties": {
        "brief_digest": {"$ref": "#/$defs/digest"},
        "reasoning_registry_version": {"const": 1},
        "reasoning_registry_digest": {"$ref": "#/$defs/digest"},
        "reasoning_registry_source_digest": {"$ref": "#/$defs/digest"},
        "planning_digests": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "source_export_digests": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "rights_digest": {"$ref": "#/$defs/digest"},
        "result_digests": {
          "type": "object",
          "required": ["reference-discovery", "reference-grammar", "reference-review"],
          "properties": {
            "reference-discovery": {"$ref": "#/$defs/digest"},
            "reference-grammar": {"$ref": "#/$defs/digest"},
            "reference-review": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        },
        "selection_scope_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "compiled_at": {"type": "string", "format": "date-time"},
    "pack_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "product_frame": {
      "type": "object",
      "required": [
        "primary_user", "user_job", "screen_family", "main_object", "core_task",
        "trust_risk", "density", "required_states", "success_metric"
      ],
      "properties": {
        "primary_user": {"type": "string", "minLength": 1},
        "user_job": {"type": "string", "minLength": 1},
        "screen_family": {"type": "string", "minLength": 1},
        "main_object": {"type": "string", "minLength": 1},
        "core_task": {"type": "string", "minLength": 1},
        "trust_risk": {"enum": ["low", "standard", "high"]},
        "density": {"enum": ["sparse", "balanced", "compact", "dense"]},
        "required_states": {"$ref": "#/$defs/strings"},
        "success_metric": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": ["frame_id", "role", "core_task", "state"],
      "properties": {
        "frame_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["operational", "transactional", "navigational", "state", "promotional"]},
        "core_task": {"type": "boolean"},
        "state": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "popularity_signal": {
      "type": "object",
      "required": [
        "id", "metric", "raw_value", "normalized_score", "scope", "category",
        "as_of", "subject_kind", "subject_record_id", "snapshot_at", "normalization",
        "evidence_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["mau", "bookmark-count", "popular-rank", "curation-popularity"]},
        "raw_value": {"type": "number"},
        "normalized_score": {"type": "number", "minimum": 0, "maximum": 100},
        "scope": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "subject_kind": {"enum": ["product", "screen"]},
        "subject_record_id": {"type": "string", "minLength": 1},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "normalization": {
          "type": "object",
          "required": ["formula", "lower_bound", "upper_bound", "direction"],
          "properties": {
            "formula": {"const": "linear-bounds-v1"},
            "lower_bound": {"type": "number"},
            "upper_bound": {"type": "number"},
            "direction": {"enum": ["higher-is-better", "lower-is-better"]}
          },
          "additionalProperties": false
        },
        "evidence_ids": {"$ref": "#/$defs/strings"}
      },
      "allOf": [{
        "if": {"properties": {"metric": {"const": "mau"}}},
        "then": {"properties": {"subject_kind": {"const": "product"}}}
      }, {
        "if": {"properties": {"metric": {"const": "popular-rank"}}},
        "then": {"properties": {"normalization": {"properties": {
          "direction": {"const": "lower-is-better"}
        }}}},
        "else": {"properties": {"normalization": {"properties": {
          "direction": {"const": "higher-is-better"}
        }}}}
      }],
      "additionalProperties": false
    },
    "ranking_signal": {
      "type": "object",
      "required": [
        "id", "metric", "subject_kind", "weight", "scope", "category", "normalization"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["mau", "bookmark-count", "popular-rank", "curation-popularity"]},
        "subject_kind": {"enum": ["product", "screen"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "scope": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "normalization": {
          "type": "object",
          "required": ["formula", "lower_bound", "upper_bound", "direction"],
          "properties": {
            "formula": {"const": "linear-bounds-v1"},
            "lower_bound": {"type": "number"},
            "upper_bound": {"type": "number"},
            "direction": {"enum": ["higher-is-better", "lower-is-better"]}
          },
          "additionalProperties": false
        }
      },
      "allOf": [{
        "if": {"properties": {"metric": {"const": "mau"}}},
        "then": {"properties": {"subject_kind": {"const": "product"}}}
      }, {
        "if": {"properties": {"metric": {"const": "popular-rank"}}},
        "then": {"properties": {"normalization": {"properties": {
          "direction": {"const": "lower-is-better"}
        }}}},
        "else": {"properties": {"normalization": {"properties": {
          "direction": {"const": "higher-is-better"}
        }}}}
      }],
      "additionalProperties": false
    },
    "product_fit": {
      "type": "object",
      "required": ["band", "score", "dimensions", "rationale", "observed_ids"],
      "properties": {
        "band": {"enum": ["exact", "adjacent", "weak"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "dimensions": {
          "type": "object",
          "required": ["user", "task", "screen", "trust", "density", "locale"],
          "properties": {
            "user": {"type": "integer", "minimum": 0, "maximum": 5},
            "task": {"type": "integer", "minimum": 0, "maximum": 5},
            "screen": {"type": "integer", "minimum": 0, "maximum": 5},
            "trust": {"type": "integer", "minimum": 0, "maximum": 5},
            "density": {"type": "integer", "minimum": 0, "maximum": 5},
            "locale": {"type": "integer", "minimum": 0, "maximum": 5}
          },
          "additionalProperties": false
        },
        "rationale": {"type": "string", "minLength": 1},
        "observed_ids": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "evidence_manifest_item": {
      "type": "object",
      "required": [
        "evidence_id", "kind", "digest", "reference_id", "product_record_id",
        "screen_record_id", "frame_ids", "subject_bindings"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["source-capture", "source-metadata"]},
        "digest": {"$ref": "#/$defs/digest"},
        "reference_id": {"$ref": "#/$defs/id"},
        "product_record_id": {"type": "string", "minLength": 1},
        "screen_record_id": {"type": "string", "minLength": 1},
        "frame_ids": {"$ref": "#/$defs/strings"},
        "subject_bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/subject_binding"}
        }
      },
      "additionalProperties": false
    },
    "subject_binding": {
      "type": "object",
      "required": ["subject_kind", "subject_record_id"],
      "properties": {
        "subject_kind": {"enum": ["product", "screen"]},
        "subject_record_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "popularity_conflict": {
      "type": "object",
      "required": [
        "signal_id", "subject_kind", "subject_record_id", "raw_value", "as_of", "note",
        "evidence_ids"
      ],
      "properties": {
        "signal_id": {"$ref": "#/$defs/id"},
        "subject_kind": {"enum": ["product", "screen"]},
        "subject_record_id": {"type": "string", "minLength": 1},
        "raw_value": {"type": "number"},
        "as_of": {"type": "string", "format": "date-time"},
        "note": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "reference_id", "role", "source", "app_name", "product_category",
        "screen_family", "platform", "environment_of_use", "business_model",
        "session_shape", "locale", "sampled_because", "family", "screen_role",
        "evidence_strength", "sampling", "component_families", "patterns", "product_fit",
        "popularity"
      ],
      "properties": {
        "reference_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["anchor", "support"]},
        "source": {
          "type": "object",
          "required": [
            "provider", "uri", "record_id", "product_record_id", "screen_record_id", "captured_at"
          ],
          "properties": {
            "provider": {"const": "uibowl"},
            "uri": {"type": "string", "format": "uri"},
            "record_id": {"type": "string", "minLength": 1},
            "product_record_id": {"type": "string", "minLength": 1},
            "screen_record_id": {"type": "string", "minLength": 1},
            "captured_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "app_name": {"type": "string", "minLength": 1},
        "product_category": {"type": "string", "minLength": 1},
        "screen_family": {"type": "string", "minLength": 1},
        "platform": {"enum": ["mobile", "desktop", "responsive"]},
        "environment_of_use": {"type": "string", "minLength": 1},
        "business_model": {"type": "string", "minLength": 1},
        "session_shape": {"enum": ["one-shot", "repeated", "interrupted", "multi-session", "exploratory"]},
        "locale": {"type": "string", "minLength": 1},
        "sampled_because": {"type": "string", "minLength": 1},
        "family": {
          "type": "object",
          "required": [
            "family_id", "frame_count", "core_task_frame_count", "state_frame_count",
            "promotional_frame_count", "frames"
          ],
          "properties": {
            "family_id": {"$ref": "#/$defs/id"},
            "frame_count": {"type": "integer", "minimum": 1},
            "core_task_frame_count": {"type": "integer", "minimum": 0},
            "state_frame_count": {"type": "integer", "minimum": 0},
            "promotional_frame_count": {"type": "integer", "minimum": 0},
            "frames": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "#/$defs/frame"}
            }
          },
          "additionalProperties": false
        },
        "screen_role": {"enum": ["operational", "transactional", "navigational", "state", "promotional"]},
        "evidence_strength": {"enum": ["weak", "medium", "strong"]},
        "sampling": {
          "type": "object",
          "required": ["ecosystem_id", "cohorts"],
          "properties": {
            "ecosystem_id": {"$ref": "#/$defs/id"},
            "cohorts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"enum": [
                "task-fit", "cross-domain", "competent-baseline", "high-bookmark", "high-reach"
              ]}
            }
          },
          "additionalProperties": false
        },
        "component_families": {"$ref": "#/$defs/strings"},
        "patterns": {"$ref": "#/$defs/strings"},
        "product_fit": {"$ref": "#/$defs/product_fit"},
        "popularity": {
          "type": "object",
          "required": ["status", "signals", "conflicts", "verified", "computed_score"],
          "properties": {
            "status": {"enum": ["verified-snapshot", "conflicted"]},
            "signals": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "#/$defs/popularity_signal"}
            },
            "conflicts": {
              "type": "array", "uniqueItems": true,
              "items": {"$ref": "#/$defs/popularity_conflict"}
            },
            "verified": {"type": "boolean"},
            "computed_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lens": {
      "type": "object",
      "required": [
        "lens_id", "question", "decision_test", "failure_if_ignored",
        "applies_to", "tradeoff", "anti_copy_boundary"
      ],
      "properties": {
        "lens_id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "minLength": 1},
        "decision_test": {"type": "string", "minLength": 1},
        "failure_if_ignored": {"type": "string", "minLength": 1},
        "applies_to": {"$ref": "#/$defs/strings"},
        "tradeoff": {"type": "string", "minLength": 1},
        "anti_copy_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verified_observation": {
      "type": "object",
      "required": [
        "observation_id", "frame_id", "frame_role", "kind", "priority",
        "statement", "evidence_ids", "reference_id"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "frame_id": {"$ref": "#/$defs/id"},
        "frame_role": {"enum": ["operational", "transactional", "navigational", "state", "promotional"]},
        "kind": {"enum": ["structure", "hierarchy", "component", "navigation", "type", "color", "state"]},
        "priority": {"enum": ["primary", "secondary", "supporting", "ambient"]},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/strings"},
        "reference_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "hierarchy_reasoning": {
      "type": "object",
      "required": [
        "reasoning_id", "observed_priority", "user_decision", "likely_constraint",
        "consequence_if_flattened", "confidence", "observed_ids", "reference_id"
      ],
      "properties": {
        "reasoning_id": {"$ref": "#/$defs/id"},
        "observed_priority": {"enum": ["primary", "secondary", "supporting", "ambient"]},
        "user_decision": {"type": "string", "minLength": 1},
        "likely_constraint": {"type": "string", "minLength": 1},
        "consequence_if_flattened": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "observed_ids": {"$ref": "#/$defs/strings"},
        "reference_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "grammar": {
      "type": "object",
      "required": [
        "grammar_id", "dimension", "principle", "application", "application_conditions",
        "tradeoff", "harmful_when", "requires_live_data", "avoid", "observed_ids",
        "reasoning_ids", "reference_id"
      ],
      "properties": {
        "grammar_id": {"$ref": "#/$defs/id"},
        "dimension": {"enum": [
          "information-hierarchy", "navigation", "component-composition", "data-comparison",
          "evidence-presentation", "typography", "color-roles", "density", "interaction", "responsive"
        ]},
        "principle": {"type": "string", "minLength": 1},
        "application": {"type": "string", "minLength": 1},
        "application_conditions": {"$ref": "#/$defs/strings"},
        "tradeoff": {"type": "string", "minLength": 1},
        "harmful_when": {"$ref": "#/$defs/strings"},
        "requires_live_data": {"type": "boolean"},
        "avoid": {"type": "string", "minLength": 1},
        "observed_ids": {"$ref": "#/$defs/strings"},
        "reasoning_ids": {"$ref": "#/$defs/strings"},
        "reference_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
