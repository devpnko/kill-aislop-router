{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devpnko/kill-aislop-router/schemas/service-planning-gate.schema.json",
  "title": "KillSlopRouter External Service Planning Gate",
  "type": "object",
  "required": [
    "planning_gate_version",
    "protocol",
    "project_id",
    "surface",
    "scope_id",
    "phase",
    "gates",
    "updated_at"
  ],
  "properties": {
    "planning_gate_version": {"const": 1},
    "protocol": {
      "type": "object",
      "required": ["id", "version", "authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "project_id": {"type": "string", "minLength": 1},
    "surface": {
      "enum": ["operator-product-ui", "consumer-product-ui", "marketing-editorial"]
    },
    "scope_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["phase_1", "phase_2"]},
    "baseline_lineage": {"$ref": "baseline-lineage-declaration.schema.json"},
    "gates": {
      "type": "object",
      "propertyNames": {"pattern": "^G(?:[0-9]+[A-Z]?|6T)$"},
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "pending",
            "passed",
            "approved",
            "blocked",
            "locked"
          ]
        },
        "note": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "digest"],
            "properties": {
              "kind": {
                "enum": [
                  "mockup",
                  "audit-receipt",
                  "approved-artifact",
                  "owner-approval",
                  "implementation-contract",
                  "implementation",
                  "test-report",
                  "other"
                ]
              },
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
