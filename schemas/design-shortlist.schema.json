{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killsloprouter.dev/schemas/design-shortlist.schema.json",
  "title": "KillSlopRouter owner direction shortlist",
  "type": "object",
  "required": ["design_shortlist_version", "run_id", "selection_scope_digest", "owner_id", "candidate_ids", "rationale", "decided_at"],
  "properties": {
    "design_shortlist_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "selection_scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "owner_id": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
