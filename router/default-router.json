{
  "schema_version": 1,
  "router_id": "kill-slop-router",
  "router_version": "1.0.0",
  "invariants": {
    "one_creator_per_artifact": true,
    "creator_cannot_self_approve": true,
    "overlapping_tools_run_as_separate_passes": true,
    "scanner_hit_is_not_a_failure": true,
    "external_result_is_not_local_authority": true,
    "browser_evidence_required_for_visual_approval": true,
    "project_contract_overrides_style_advice": true,
    "planning_authority_stays_external": true,
    "design_system_release_requires_exact_owner_approval": true,
    "profile_commands_are_never_executed": true,
    "routable_is_not_execution_evidence": true,
    "surface_is_not_a_visual_style_preset": true,
    "anti_slop_critique_is_not_creator_direction": true,
    "editorial_treatment_requires_verified_visual_intent": true,
    "scanner_zero_hits_is_not_design_approval": true,
    "visual_intent_authority_is_digest_bound": true,
    "visual_signature_authority_is_digest_bound": true,
    "palette_frequency_is_not_style_authority": true,
    "critic_preferences_cannot_override_visual_signature": true,
    "missing_direction_requires_design_exploration": true,
    "design_candidates_require_playwright_evidence": true,
    "design_shortlist_and_palette_require_owner_selection": true,
    "locale_domain_privacy_browser_and_owner_gates_remain_hard": true,
    "parent_orchestrator_identity_is_digest_bound": true,
    "child_provider_names_are_internal_roles_not_modes": true,
    "legacy_skill_entry_conflicts_fail_closed": true,
    "automation_state_leases_are_exclusive": true,
    "latest_version_never_promotes_parent_baseline": true,
    "slice_lineage_is_digest_bound_to_parent_and_candidate": true,
    "reference_popularity_cannot_override_product_fit_or_hard_gates": true,
    "reference_pack_is_discovery_evidence_not_visual_authority": true,
    "reference_source_pixels_do_not_reach_creators": true,
    "reference_research_requires_independent_critic_and_owner_selection": true,
    "reference_reasoning_registry_is_digest_bound_and_non_authoritative": true,
    "reference_hierarchy_requires_observation_decision_constraint_and_consequence": true,
    "promotional_reference_cannot_establish_operational_grammar": true,
    "reference_sampling_limits_product_and_ecosystem_dominance": true,
    "unverified_popularity_cannot_block_reference_eligibility": true
  },
  "provider_capabilities": {
    "project-contract": {"strength": 4, "capabilities": ["task-contract", "object-model", "state-authority"]},
    "project-design-system": {"strength": 4, "capabilities": ["approved-direction", "component-system", "domain-density"]},
    "project-systemizer": {"strength": 4, "capabilities": ["artifact-inventory", "token-taxonomy", "component-taxonomy", "variant-contract", "surface-profile-contract", "migration-map"]},
    "design-system-contract-review": {"strength": 4, "independent_from_creator": true, "capabilities": ["token-contract", "component-boundaries", "variant-state-contract", "responsive-density-contract", "surface-profile-contract", "migration-map", "drift-control"]},
    "kill-ai-slop": {"strength": 2, "capabilities": ["source-pattern-detection"]},
    "anti-slop": {"strength": 3, "independent_from_creator": true, "capabilities": ["task-fit", "state-completeness", "responsive-review", "accessibility-review", "interaction-review"]},
    "hallmark": {"strength": 3, "independent_from_creator": true, "capabilities": ["rendered-hierarchy", "visual-specificity", "visual-restraint", "component-coherence"]},
    "taste-skill": {"strength": 3, "independent_from_creator": true, "capabilities": ["direction-coherence", "visual-specificity"]},
    "no-ai-slop": {"strength": 3, "independent_from_creator": true, "capabilities": ["copy-specificity", "copy-honesty", "copy-concision"]},
    "stop-slop": {"strength": 2, "independent_from_creator": true, "capabilities": ["long-form-rhythm", "formulaic-prose-detection"]},
    "peakoss-anti-slop": {"strength": 3, "independent_from_creator": true, "capabilities": ["pr-contribution-hygiene"]},
    "locale-copy-review": {"strength": 4, "capabilities": ["locale-domain-copy"]},
    "visual-intent-review": {"strength": 4, "independent_from_creator": true, "capabilities": ["visual-intent-fidelity", "editorial-boundary", "character-preservation", "energy-preservation", "depth-preservation", "palette-fidelity", "typography-fidelity", "density-fidelity", "shape-fidelity", "elevation-fidelity", "imagery-fidelity", "motion-fidelity", "transformation-boundary"]},
    "browser-evidence": {"strength": 3, "independent_from_creator": true, "capabilities": ["responsive-evidence", "keyboard-evidence", "state-evidence", "overflow-evidence", "contrast-evidence", "zoom-evidence"]},
    "domain-authority-review": {"strength": 4, "independent_from_creator": true, "capabilities": ["domain-authority"]},
    "privacy-authority-review": {"strength": 4, "independent_from_creator": true, "capabilities": ["privacy-authority"]},
    "owner-approval": {"strength": 4, "independent_from_creator": true, "capabilities": ["owner-approval"]}
  },
  "stage_capability_contracts": {
    "project-contract": {"minimum_strength": 4, "required": ["task-contract", "object-model", "state-authority"]},
    "visual-intent-review": {"minimum_strength": 4, "requires_independent_critic": true, "required": ["visual-intent-fidelity", "editorial-boundary", "character-preservation", "energy-preservation", "depth-preservation", "palette-fidelity", "typography-fidelity", "density-fidelity", "shape-fidelity", "elevation-fidelity", "imagery-fidelity", "motion-fidelity", "transformation-boundary"]},
    "system-contract-review": {"minimum_strength": 4, "requires_independent_critic": true, "required": ["token-contract", "component-boundaries", "variant-state-contract", "responsive-density-contract", "surface-profile-contract", "migration-map", "drift-control"]},
    "static-discovery": {"minimum_strength": 2, "required": ["source-pattern-detection"]},
    "functional-human-review": {"minimum_strength": 3, "requires_independent_critic": true, "required": ["task-fit", "state-completeness", "responsive-review", "accessibility-review", "interaction-review"]},
    "rendered-craft-review": {"minimum_strength": 3, "requires_independent_critic": true, "required": ["rendered-hierarchy", "visual-specificity", "visual-restraint", "component-coherence"]},
    "direction-coherence-review": {"minimum_strength": 3, "requires_independent_critic": true, "required": ["direction-coherence", "visual-specificity"]},
    "copy-review": {"minimum_strength": 3, "requires_independent_critic": true, "required": ["copy-specificity", "copy-honesty", "copy-concision", "locale-domain-copy"]},
    "optional-long-form-review": {"minimum_strength": 2, "requires_independent_critic": true, "required": ["long-form-rhythm", "formulaic-prose-detection"]},
    "browser-evidence": {"minimum_strength": 3, "requires_independent_critic": true, "evidence_required": true, "required_evidence_kinds": ["screenshot", "test-report"], "required": ["responsive-evidence", "keyboard-evidence", "state-evidence", "overflow-evidence", "contrast-evidence", "zoom-evidence"]},
    "adjudication": {"minimum_strength": 4, "required": ["domain-authority"]},
    "high-risk-project-gates": {"minimum_strength": 4, "required": ["privacy-authority"]},
    "approval": {"minimum_strength": 4, "required": ["owner-approval"]},
    "pr-hygiene": {"minimum_strength": 3, "requires_independent_critic": true, "required": ["pr-contribution-hygiene"]}
  },
  "routes": [
    {
      "id": "copy-only",
      "match": {"task": "copy"},
      "creator_policy": {"type": "none"},
      "stages": [
        {"id": "copy-review", "question": "Is the copy specific, honest, concise, and voice-preserving?", "actors": [{"id": "no-ai-slop", "kind": "external"}, {"id": "locale-copy-review", "kind": "local"}]},
        {"id": "optional-long-form-review", "question": "Does unresolved long-form prose still contain formulaic structure or rhythm?", "optional": true, "actors": [{"id": "stop-slop", "kind": "external"}]},
        {"id": "adjudication", "question": "Does the edited copy preserve project meaning and authority?", "actors": [{"id": "domain-authority-review", "kind": "local"}]}
      ]
    },
    {
      "id": "existing-ui-audit",
      "match": {"task": "audit"},
      "creator_policy": {"type": "none"},
      "stages": [
        {"id": "project-contract", "question": "What user task, object, states, and authority define this artifact?", "actors": [{"id": "project-contract", "kind": "local"}]},
        {"id": "visual-intent-review", "question": "Does the artifact follow the verified visual-intent and visual-signature contracts exactly, including palette tokens, typography, density, shape, elevation, imagery, motion, and forbidden transformations?", "when_visual_intent": true, "actors": [{"id": "visual-intent-review", "kind": "local"}]},
        {"id": "static-discovery", "question": "Which source patterns are anti-slop review candidates?", "actors": [{"id": "kill-ai-slop", "kind": "external", "mode": "read-only-json"}]},
        {"id": "functional-human-review", "question": "Does the interface work for the real task, people, mobile layout, accessibility, and required states?", "actors": [{"id": "anti-slop", "kind": "external"}]},
        {"id": "rendered-craft-review", "question": "Does the rendered interface have specific hierarchy, intentional visual character, appropriate depth, and execution quality without flattening the approved direction?", "actors": [{"id": "hallmark", "kind": "external"}]},
        {"id": "copy-review", "question": "Is visible copy specific, honest, concise, and natural?", "actors": [{"id": "no-ai-slop", "kind": "external"}, {"id": "locale-copy-review", "kind": "local"}]},
        {"id": "browser-evidence", "question": "Do required viewports, states, keyboard paths, and controls work in a browser?", "actors": [{"id": "browser-evidence", "kind": "local"}]},
        {"id": "adjudication", "question": "How are conflicting findings resolved against product semantics and evidence?", "actors": [{"id": "domain-authority-review", "kind": "local"}]},
        {"id": "approval", "question": "Who accepts the result and remaining debt?", "actors": [{"id": "owner-approval", "kind": "local"}]}
      ]
    },
    {
      "id": "pr-hygiene",
      "match": {"task": "pr-hygiene"},
      "creator_policy": {"type": "none"},
      "stages": [
        {"id": "pr-hygiene", "question": "Does the contribution meet separately approved PR-quality rules?", "actors": [{"id": "peakoss-anti-slop", "kind": "external", "mode": "separately-approved"}]}
      ]
    },
    {
      "id": "design-system-extraction",
      "match": {"task": "systemize"},
      "creator_policy": {"type": "fixed", "tool": "project-systemizer", "requires_profile_adapter": "project-systemizer", "allow_surface_override": false},
      "stages": [
        {"id": "project-contract", "question": "Which approved artifact, user task, object model, states, and authority bound this extraction?", "actors": [{"id": "project-contract", "kind": "local"}]},
        {"id": "visual-intent-review", "question": "Does systemization preserve the verified palette tokens, typography, density, shape, elevation, imagery, motion, character, energy, depth, and editorial boundary instead of normalizing them into a universal style?", "when_visual_intent": true, "actors": [{"id": "visual-intent-review", "kind": "local"}]},
        {"id": "static-discovery", "question": "Which duplicated or generic source patterns must not enter the shared system?", "actors": [{"id": "kill-ai-slop", "kind": "external", "mode": "read-only-json"}]},
        {"id": "system-contract-review", "question": "Are tokens, component boundaries, variants, responsive profiles, migration order, and drift controls explicit and reusable?", "actors": [{"id": "design-system-contract-review", "kind": "local"}]},
        {"id": "functional-human-review", "question": "Does systemization preserve real tasks, states, accessibility, and mobile behavior instead of flattening the product?", "actors": [{"id": "anti-slop", "kind": "external"}]},
        {"id": "rendered-craft-review", "question": "Do the shared primitives preserve the approved hierarchy, energy, depth, and surface-specific character?", "actors": [{"id": "hallmark", "kind": "external"}]},
        {"id": "browser-evidence", "question": "Do component variants and representative surfaces work at required viewports and interaction states?", "actors": [{"id": "browser-evidence", "kind": "local"}]},
        {"id": "adjudication", "question": "Which patterns are truly shared, and which must remain product- or surface-specific?", "actors": [{"id": "domain-authority-review", "kind": "local"}]},
        {"id": "approval", "question": "Who approves this versioned design-system release and its migration boundary?", "actors": [{"id": "owner-approval", "kind": "local"}]}
      ]
    },
    {
      "id": "operator-product-ui",
      "match": {"surface": "operator-product-ui", "task": ["build", "redesign", "runtime-handoff"]},
      "creator_policy": {"type": "fixed", "tool": "project-design-system", "requires_profile_flag": "approved_design_system"},
      "excluded_tools": ["taste-skill"],
      "stages": [
        {"id": "project-contract", "question": "What operator decision, data density, states, and authority define this artifact?", "actors": [{"id": "project-contract", "kind": "local"}]},
        {"id": "visual-intent-review", "question": "Does the operator UI preserve the exact verified palette, typography, compact density, shape, elevation, imagery, motion, energy, and brand character while rejecting every forbidden transformation?", "when_visual_intent": true, "actors": [{"id": "visual-intent-review", "kind": "local"}]},
        {"id": "functional-human-review", "question": "Does the dense product UI support the real task, mobile fallback, accessibility, and state completeness?", "actors": [{"id": "anti-slop", "kind": "external"}]},
        {"id": "static-discovery", "question": "Which source patterns are anti-slop review candidates?", "actors": [{"id": "kill-ai-slop", "kind": "external", "mode": "read-only-json"}]},
        {"id": "rendered-craft-review", "question": "Does the rendered interface preserve task hierarchy, required density, approved visual energy, and intentional depth?", "actors": [{"id": "hallmark", "kind": "external", "skip_if_creator": true}]},
        {"id": "copy-review", "question": "Is visible operator copy direct, domain-correct, and non-generic?", "actors": [{"id": "no-ai-slop", "kind": "external"}, {"id": "locale-copy-review", "kind": "local"}]},
        {"id": "browser-evidence", "question": "Do required viewports, states, keyboard paths, and controls work in a browser?", "actors": [{"id": "browser-evidence", "kind": "local"}]},
        {"id": "adjudication", "question": "How are density and visual-intent conflicts resolved against the operator task and verified contract?", "actors": [{"id": "domain-authority-review", "kind": "local"}]},
        {"id": "approval", "question": "Who accepts the result and remaining debt?", "actors": [{"id": "owner-approval", "kind": "local"}]}
      ]
    },
    {
      "id": "consumer-product-ui",
      "match": {"surface": "consumer-product-ui", "task": ["build", "redesign", "runtime-handoff"]},
      "creator_policy": {
        "type": "by-direction",
        "cases": [
          {"direction": "approved", "tool": "project-design-system", "requires_profile_flag": "approved_design_system"},
          {"direction": "missing", "requires_design_exploration": true},
          {"direction": "reference", "tool": "hallmark"}
        ]
      },
      "stages": [
        {"id": "project-contract", "question": "What customer task, trust boundary, states, and outcome define this artifact?", "actors": [{"id": "project-contract", "kind": "local"}]},
        {"id": "visual-intent-review", "question": "Does the customer UI preserve the exact verified palette, typography, density, shape, elevation, imagery, motion, brand character, energy, depth, and editorial boundary?", "when_visual_intent": true, "actors": [{"id": "visual-intent-review", "kind": "local"}]},
        {"id": "functional-human-review", "question": "Does the interface work for the real customer task, mobile layout, accessibility, and required states?", "actors": [{"id": "anti-slop", "kind": "external"}]},
        {"id": "static-discovery", "question": "Which source patterns are anti-slop review candidates?", "actors": [{"id": "kill-ai-slop", "kind": "external", "mode": "read-only-json"}]},
        {"id": "rendered-craft-review", "question": "Does the rendered interface have specific hierarchy, brand character, intentional depth, and execution quality without generic neutralization?", "actors": [{"id": "hallmark", "kind": "external", "skip_if_creator": true}]},
        {"id": "direction-coherence-review", "question": "Does the chosen visual direction remain coherent, specific, and inside the verified visual-intent contract?", "when_creator": ["hallmark"], "actors": [{"id": "taste-skill", "kind": "external", "skip_if_creator": true}]},
        {"id": "copy-review", "question": "Is customer copy specific, honest, concise, and natural?", "actors": [{"id": "no-ai-slop", "kind": "external"}, {"id": "locale-copy-review", "kind": "local"}]},
        {"id": "browser-evidence", "question": "Do required viewports, states, keyboard paths, and controls work in a browser?", "actors": [{"id": "browser-evidence", "kind": "local"}]},
        {"id": "adjudication", "question": "How are trust, task, and visual findings resolved against project semantics?", "actors": [{"id": "domain-authority-review", "kind": "local"}]},
        {"id": "approval", "question": "Who accepts the result and remaining debt?", "actors": [{"id": "owner-approval", "kind": "local"}]}
      ]
    },
    {
      "id": "marketing-editorial",
      "match": {"surface": "marketing-editorial", "task": ["build", "redesign", "runtime-handoff"]},
      "creator_policy": {
        "type": "by-direction",
        "cases": [
          {"direction": "approved", "tool": "project-design-system", "requires_profile_flag": "approved_design_system"},
          {"direction": "missing", "requires_design_exploration": true},
          {"direction": "reference", "tool": "hallmark"}
        ]
      },
      "stages": [
        {"id": "project-contract", "question": "What audience, offer, evidence, action, and brand direction define this artifact?", "actors": [{"id": "project-contract", "kind": "local"}]},
        {"id": "visual-intent-review", "question": "Does the page preserve the exact verified palette, typography, density, shape, elevation, imagery, motion, brand character, energy, and depth, with editorial treatment only where explicitly permitted?", "when_visual_intent": true, "actors": [{"id": "visual-intent-review", "kind": "local"}]},
        {"id": "static-discovery", "question": "Which source patterns are anti-slop review candidates?", "actors": [{"id": "kill-ai-slop", "kind": "external", "mode": "read-only-json"}]},
        {"id": "functional-human-review", "question": "Do responsive behavior, accessibility, controls, and states work for real visitors?", "actors": [{"id": "anti-slop", "kind": "external"}]},
        {"id": "rendered-craft-review", "question": "Does the rendered page have specific hierarchy, brand character, intentional depth, and execution quality without defaulting to paper/editorial neutral?", "when_creator": ["taste-skill", "project-design-system"], "actors": [{"id": "hallmark", "kind": "external", "skip_if_creator": true}]},
        {"id": "direction-coherence-review", "question": "Does the visual direction remain coherent, non-generic, and inside the verified editorial boundary?", "when_creator": ["hallmark"], "actors": [{"id": "taste-skill", "kind": "external", "skip_if_creator": true}]},
        {"id": "copy-review", "question": "Is the public copy specific, credible, and free of generic claims?", "actors": [{"id": "no-ai-slop", "kind": "external"}, {"id": "locale-copy-review", "kind": "local"}, {"id": "stop-slop", "kind": "external", "optional": true}]},
        {"id": "browser-evidence", "question": "Do required viewports, states, keyboard paths, and controls work in a browser?", "actors": [{"id": "browser-evidence", "kind": "local"}]},
        {"id": "adjudication", "question": "How are evidence, brand, and visual findings resolved?", "actors": [{"id": "domain-authority-review", "kind": "local"}]},
        {"id": "approval", "question": "Who accepts the result and remaining debt?", "actors": [{"id": "owner-approval", "kind": "local"}]}
      ]
    }
  ],
  "change_requirements": {
    "copy": ["copy-review"],
    "style": ["visual-intent-review", "static-discovery", "rendered-craft-review", "browser-evidence"],
    "layout": ["visual-intent-review", "static-discovery", "functional-human-review", "rendered-craft-review", "browser-evidence"],
    "interaction": ["functional-human-review", "browser-evidence"],
    "state": ["functional-human-review", "browser-evidence"],
    "data": ["project-contract", "domain-authority-review"],
    "authority": ["project-contract", "domain-authority-review", "owner-approval"]
  },
  "adjudication": {
    "hard_blockers": [
      "fabricated-data-or-claim",
      "dead-or-misleading-control",
      "authority-or-privacy-leak",
      "missing-required-state",
      "keyboard-failure",
      "contrast-failure",
      "overflow-overlap-or-clipping",
      "visual-intent-contract-violation",
      "visual-signature-contract-violation",
      "brand-token-substitution",
      "unapproved-style-normalization",
      "unapproved-editorial-treatment",
      "fake-runtime-claim"
    ],
    "reviewer_disagreement": "record-both-do-not-average",
    "style_conflict": "visual-signature-contract-then-visual-intent-contract-then-project-contract-then-owner-replan",
    "scanner_conflict": "semantic-triage-with-rendered-evidence"
  }
}
